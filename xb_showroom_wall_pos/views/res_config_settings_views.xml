<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_showroom_pos" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.showroom.pos</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='pos_interface_section']" position="inside">
                <setting string="Showroom wall" invisible="is_kiosk_mode"
                         help="The cashier can show a piece on this wall from the register. Only products ticked 'Show on the showroom wall'.">
                    <field name="pos_xb_showroom_pos_screen_id" options="{'no_create': True}"/>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
