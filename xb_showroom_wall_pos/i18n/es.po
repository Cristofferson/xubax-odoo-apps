#. module: xb_showroom_wall_pos
#: model_terms:ir.ui.view,arch_db:xb_showroom_wall_pos.res_config_settings_view_form_showroom_pos
msgid ""
"The cashier can show a piece on this wall from the register. Only products "
"ticked 'Show on the showroom wall'."
msgstr ""
"Desde la caja se puede mostrar una pieza en este muro. Solo productos con la"
" casilla «Ver en el muro del showroom»."

#. module: xb_showroom_wall_pos
#: model:ir.model.fields,help:xb_showroom_wall_pos.field_pos_config__xb_showroom_pos_screen_id
#: model:ir.model.fields,help:xb_showroom_wall_pos.field_res_config_settings__pos_xb_showroom_pos_screen_id
msgid ""
"The register gets a 'Show on the wall' button that sends the piece to this "
"wall. Only products ticked 'Show on the showroom wall'."
msgstr ""
"La caja tiene un botón «Ver en el muro» que manda la pieza a este muro. Solo"
" productos con la casilla «Ver en el muro del showroom»."

