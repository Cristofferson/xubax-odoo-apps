#. module: xibo_connector_pos_showcase
#: model:ir.model.fields,help:xibo_connector_pos_showcase.field_pos_config__xibo_showcase_enabled
#: model:ir.model.fields,help:xibo_connector_pos_showcase.field_res_config_settings__pos_xibo_showcase_enabled
msgid ""
"When idle, show a rotating catalog gallery + a QR that opens the online "
"store on the customer's phone."
msgstr "En reposo, muestra una galería rotativa del catálogo y un QR que abre la tienda en línea en el teléfono del cliente."

#. module: xibo_connector_pos_showcase
#: model_terms:ir.ui.view,arch_db:xibo_connector_pos_showcase.res_config_settings_view_form_xibo_showcase
msgid ""
"When idle, the videowall shows a rotating gallery of your online catalog "
"plus a QR code that opens the web store on the customer's phone."
msgstr "En reposo, el videowall muestra una galería rotativa de su catálogo en línea y un código QR que abre la tienda en el teléfono del cliente."

#. module: xibo_connector_pos_showcase
#: model_terms:ir.ui.view,arch_db:xibo_connector_pos_showcase.res_config_settings_view_form_xibo_showcase
msgid "Where the QR sends the customer. Empty = this server's /shop."
msgstr "A dónde lleva el QR al cliente. Vacío = la tienda (/shop) de este servidor."

#. module: xibo_connector_pos_showcase
#: model:ir.model.fields,help:xibo_connector_pos_showcase.field_pos_config__xibo_showcase_url
#: model:ir.model.fields,help:xibo_connector_pos_showcase.field_res_config_settings__pos_xibo_showcase_url
msgid ""
"Where the QR sends the customer. Leave empty to use this server's online "
"shop (/shop)."
msgstr "A dónde lleva el QR al cliente. Déjelo vacío para usar la tienda en línea de este servidor (/shop)."

#. module: xibo_connector_pos_showcase
