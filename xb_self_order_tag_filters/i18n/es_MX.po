#. module: xb_self_order_tag_filters
#: model:ir.model.fields,help:xb_self_order_tag_filters.field_pos_config__xb_tf_show_count
#: model:ir.model.fields,help:xb_self_order_tag_filters.field_res_config_settings__pos_xb_tf_show_count
msgid "Each option shows how many products it leaves."
msgstr "Cada opción muestra cuántos productos deja."

#. module: xb_self_order_tag_filters
#: model_terms:ir.ui.view,arch_db:xb_self_order_tag_filters.res_config_settings_view_form_kiosk_filters
msgid ""
"Empty colors take the kiosk theme. Filters are ordered like the tag filter "
"groups, the website sections first."
msgstr ""
"Sin color se usan los del tema del kiosco. Los filtros siguen el orden de "
"los grupos de etiquetas; primero las secciones de la tienda."

#. module: xb_self_order_tag_filters
