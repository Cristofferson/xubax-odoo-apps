#. module: xb_self_order_tag_filters
#: model:ir.model.fields.selection,name:xb_self_order_tag_filters.selection__pos_config__xb_tf_icons__color
msgid "Tag color"
msgstr "Color de la etiqueta"

#. module: xb_self_order_tag_filters
#: model:ir.model.fields,help:xb_self_order_tag_filters.field_pos_config__xb_tf_icons
#: model:ir.model.fields,help:xb_self_order_tag_filters.field_res_config_settings__pos_xb_tf_icons
msgid ""
"Tag color: a dot with the color of each tag (when it has one).\n"
"Jewelry drawings: stone shapes (Round, Princess, Oval…) and metal colors (White gold, Yellow gold, Rose gold…), recognised by the option name."
msgstr ""
"Color de la etiqueta: un punto con el color de cada etiqueta (si lo tiene).\n"
"Dibujos de joyería: formas de piedra (Redondo, Princesa, Oval…) y colores del metal (Oro blanco, Oro amarillo, Oro rosa…), reconocidos por el nombre de la opción."

#. module: xb_self_order_tag_filters
#: model:ir.model.fields.selection,name:xb_self_order_tag_filters.selection__pos_config__xb_tf_layout__line
msgid "Text line"
msgstr "Línea de texto"

#. module: xb_self_order_tag_filters
#: model:ir.model.fields,help:xb_self_order_tag_filters.field_product_public_category__xb_kiosk_filter_multi
msgid ""
"The customer can pick several subcategories of this filter at once. Off: one"
" at a time (e.g. a single metal)."
msgstr ""
"El cliente puede elegir varias subcategorías de este filtro a la vez. "
"Apagado: una a la vez (p. ej. un solo metal)."

#. module: xb_self_order_tag_filters
#: model:ir.model.fields,help:xb_self_order_tag_filters.field_pos_config__xb_tf_categ_ids
#: model:ir.model.fields,help:xb_self_order_tag_filters.field_res_config_settings__pos_xb_tf_categ_ids
msgid ""
"The kiosk categories that offer filters. Empty: every category with "
"something to filter."
msgstr ""
"Las categorías del kiosco que ofrecen filtros. Vacío: todas las que tengan "
"algo que filtrar."

#. module: xb_self_order_tag_filters
#: model:ir.model.fields,help:xb_self_order_tag_filters.field_product_public_category__xb_kiosk_filter_title
msgid ""
"When set, the subcategories of this category are offered as a filter in the "
"self-order kiosk, under this title (e.g. \"Metal\")."
msgstr ""
"Si lo llenas, las subcategorías de esta categoría se ofrecen como filtro en "
"el kiosco de autoservicio, con este título (p. ej. «Metal»)."

#. module: xb_self_order_tag_filters
#: model_terms:ir.ui.view,arch_db:xb_self_order_tag_filters.product_public_category_form_view
msgid "e.g. Metal"
msgstr "p. ej. Metal"
