<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="xb_sale_order_wa_automation_view_list" model="ir.ui.view">
        <field name="name">xb.sale.order.wa.automation.list</field>
        <field name="model">xb.sale.order.wa.automation</field>
        <field name="arch" type="xml">
            <list string="Automatic WhatsApp messages" editable="bottom" create="0" delete="0">
                <field name="sequence" widget="handle"/>
                <field name="kind"/>
                <field name="enabled" widget="boolean_toggle"/>
                <field name="template_id" options="{'no_create': True}"/>
                <field name="delay_days" invisible="kind not in ('pickup', 'followup')"/>
                <field name="quiet_days" invisible="kind not in ('pickup', 'followup')"/>
                <field name="review_url" invisible="kind != 'followup'" widget="url"/>
                <field name="since"/>
                <field name="company_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="xb_sale_order_wa_automation_action" model="ir.actions.server">
        <field name="name">Automatic WhatsApp messages</field>
        <field name="model_id" ref="model_xb_sale_order_wa_automation"/>
        <field name="state">code</field>
        <field name="code">action = model.action_xb_open()</field>
        <field name="group_ids" eval="[(4, ref('sales_team.group_sale_manager'))]"/>
    </record>

    <record id="xb_sale_order_wa_log_view_list" model="ir.ui.view">
        <field name="name">xb.sale.order.wa.log.list</field>
        <field name="model">xb.sale.order.wa.log</field>
        <field name="arch" type="xml">
            <list string="WhatsApp messages about orders" create="0" edit="0"
                  decoration-danger="failed" decoration-muted="not automatic">
                <field name="date"/>
                <field name="order_id"/>
                <field name="partner_id"/>
                <field name="kind"/>
                <field name="automatic"/>
                <field name="reply" optional="show"/>
                <field name="failed" optional="show"/>
                <field name="failure" optional="hide"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="xb_sale_order_wa_log_view_search" model="ir.ui.view">
        <field name="name">xb.sale.order.wa.log.search</field>
        <field name="model">xb.sale.order.wa.log</field>
        <field name="arch" type="xml">
            <search>
                <field name="order_id"/>
                <field name="partner_id"/>
                <filter name="automatic" string="Automatic" domain="[('automatic', '=', True)]"/>
                <filter name="failed" string="Failed" domain="[('failed', '=', True)]"/>
                <filter name="answered" string="Follow-up answered" domain="[('reply', '!=', False)]"/>
                <group>
                    <filter name="group_kind" string="Message" context="{'group_by': 'kind'}"/>
                    <filter name="group_reply" string="Answer" context="{'group_by': 'reply'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="xb_sale_order_wa_log_action" model="ir.actions.act_window">
        <field name="name">WhatsApp messages about orders</field>
        <field name="res_model">xb.sale.order.wa.log</field>
        <field name="view_mode">list</field>
    </record>

    <menuitem id="xb_sale_order_wa_automation_menu" name="Automatic WhatsApp messages"
              parent="sale.menu_sale_config" action="xb_sale_order_wa_automation_action"
              sequence="90" groups="sales_team.group_sale_manager"/>
    <menuitem id="xb_sale_order_wa_log_menu" name="WhatsApp messages about orders"
              parent="sale.menu_sale_report" action="xb_sale_order_wa_log_action"
              sequence="90" groups="sales_team.group_sale_salesman"/>
</odoo>
