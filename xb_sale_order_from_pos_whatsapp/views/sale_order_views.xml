<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
      WhatsApp notices about an order (ready, late...). ONE button: it opens a window
      where the seller picks what to tell the customer. The base orders list
      (sale.sale_order_tree) is also the list the POS opens to recover an order (native
      SelectCreateDialog), so one row button serves Sales and the Point of Sale. Visible
      only for orders/layaways of a company that has at least one notice template
      (xb_can_notify_wa).
      The record ids keep their old "ready notice" names: they are already in the
      databases where 1.1.0 was installed.
    -->
    <record id="view_order_tree_xb_ready_notice" model="ir.ui.view">
        <field name="name">sale.order.list.xb.whatsapp.notice</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.sale_order_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="inside">
                <field name="xb_can_notify_wa" column_invisible="1"/>
                <field name="xb_ready_notified_date" optional="hide" string="Ready notice"/>
            </xpath>
            <!-- Right after the customer: the list the POS opens is narrow and has many
                 columns, a button at the end of the row is off-screen for the cashier. -->
            <xpath expr="//field[@name='partner_id']" position="after">
                <button name="action_xb_notify_whatsapp" type="object" icon="fa-whatsapp"
                        string="Notify"
                        title="Send the customer a WhatsApp notice about this order: ready, balance due, late..."
                        class="text-success"
                        invisible="not xb_can_notify_wa or xb_ready_notified_date"/>
                <button name="action_xb_notify_whatsapp" type="object" icon="fa-check"
                        string="Notified"
                        title="Already told it is ready. Click to send another notice."
                        class="text-muted"
                        invisible="not xb_can_notify_wa or not xb_ready_notified_date"/>
            </xpath>
        </field>
    </record>

    <record id="view_order_form_xb_ready_notice" model="ir.ui.view">
        <field name="name">sale.order.form.xb.whatsapp.notice</field>
        <!-- Off since 1.3.0: the chatter's own WhatsApp button opens the notices window,
             and two WhatsApp buttons on one order was one too many. Kept (inactive)
             instead of deleted so an interrupted upgrade cannot leave it half-removed. -->
        <field name="active" eval="False"/>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header/button[@id='quotation_send']" position="after">
                <field name="xb_can_notify_wa" invisible="1"/>
                <button name="action_xb_notify_whatsapp" type="object" icon="fa-whatsapp"
                        string="Notify the customer (WhatsApp)"
                        title="Send the customer a WhatsApp notice about this order: ready, balance due, late..."
                        invisible="not xb_can_notify_wa"/>
            </xpath>
        </field>
    </record>
</odoo>
