#: model:ir.model.fields,help:xb_sale_order_from_pos_whatsapp.field_sale_order__xb_wa_balance_text
msgid ""
"\"Balance due: $650.00.\" or \"It is fully paid.\", in the customer's "
"language."
msgstr "«Saldo por liquidar: $650.00.» o «Quedó liquidado por completo.», en el idioma del cliente."

#. module: xb_sale_order_from_pos_whatsapp
#: model:ir.model.fields,help:xb_sale_order_from_pos_whatsapp.field_sale_order__xb_wa_kind_label
msgid ""
"\"order\" or \"layaway\" in the customer's language, for \"Your order ... is"
" ready\"."
msgstr "«pedido» o «apartado» en el idioma del cliente, para «Tu pedido … ya está listo»."

