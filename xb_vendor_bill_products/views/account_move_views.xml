<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_move_form_xb_vbp" model="ir.ui.view">
        <field name="name">account.move.form.xb.vbp</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button name="action_xb_vbp_open_proposals" type="object"
                        class="oe_stat_button" icon="fa-lightbulb-o"
                        invisible="xb_vbp_proposal_count == 0">
                    <field name="xb_vbp_proposal_count" widget="statinfo"
                           string="Proposed"/>
                </button>
            </div>
        </field>
    </record>

</odoo>
