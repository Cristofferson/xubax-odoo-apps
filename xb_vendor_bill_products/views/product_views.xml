<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="product_template_form_view_xb_vbp" model="ir.ui.view">
        <field name="name">product.template.form.xb.vbp</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button name="action_xb_vbp_view_image_candidates" type="object"
                        class="oe_stat_button" icon="fa-picture-o"
                        invisible="xb_vbp_image_candidate_count == 0">
                    <field name="xb_vbp_image_candidate_count" widget="statinfo"
                           string="Image candidates"/>
                </button>
            </div>
            <field name="active" position="after">
                <field name="xb_vbp_auto_created" invisible="1"/>
                <field name="xb_vbp_image_candidate_count" invisible="1"/>
            </field>
        </field>
    </record>

    <record id="product_template_search_view_xb_vbp" model="ir.ui.view">
        <field name="name">product.template.search.xb.vbp</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_search_view"/>
        <field name="arch" type="xml">
            <filter name="inactive" position="before">
                <separator/>
                <filter name="xb_vbp_auto_created" string="Created from a vendor bill"
                        domain="[('xb_vbp_auto_created', '=', True)]"/>
                <filter name="xb_vbp_no_image" string="Without image"
                        domain="[('image_1920', '=', False)]"/>
            </filter>
        </field>
    </record>

    <record id="action_xb_vbp_search_images" model="ir.actions.server">
        <field name="name">Look for a product image</field>
        <field name="model_id" ref="product.model_product_template"/>
        <field name="binding_model_id" ref="product.model_product_template"/>
        <field name="binding_view_types">list,form</field>
        <field name="state">code</field>
        <field name="code">action = records.action_xb_vbp_search_images()</field>
    </record>

</odoo>
