<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_cm_listing_form" model="ir.ui.view">
        <field name="name">xb.cm.listing.form</field>
        <field name="model">xb.cm.listing</field>
        <field name="arch" type="xml">
            <form string="Room mapping">
                <header>
                    <button name="action_pull_now" type="object"
                            string="Sync this room now" class="btn-primary"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_reservations" type="object"
                                class="oe_stat_button" icon="fa-calendar">
                            <field name="reservation_count" widget="statinfo"
                                   string="Reservations"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Mapping">
                            <field name="active" invisible="1"/>
                            <field name="channel_id"/>
                            <field name="channel_type" invisible="1"/>
                            <field name="product_tmpl_id"/>
                            <field name="effective_capacity"/>
                            <field name="capacity"/>
                        </group>
                        <group string="Status">
                            <field name="last_pull"/>
                            <field name="last_push"/>
                        </group>
                    </group>
                    <group string="iCal two-way sync"
                           invisible="channel_type != 'ical'">
                        <field name="ical_export_url" readonly="1"
                               widget="CopyClipboardChar"/>
                        <field name="ical_import_url"
                               placeholder="https://www.airbnb.com/calendar/ical/…"/>
                        <button name="action_regenerate_token" type="object"
                                string="Regenerate export token"
                                class="btn-link" icon="fa-refresh"
                                confirm="Regenerate the export URL? You must update it on the OTA."/>
                    </group>
                    <group string="Channex mapping"
                           invisible="channel_type != 'channex'">
                        <group>
                            <field name="channex_room_type_id"/>
                            <field name="rate_push"/>
                        </group>
                        <group>
                            <field name="base_price"/>
                            <button name="action_open_rates_preview"
                                    type="object" icon="fa-eye"
                                    string="Preview rates sent"
                                    class="btn-link"/>
                        </group>
                    </group>
                    <notebook invisible="channel_type != 'channex'">
                        <page string="Rate plans" name="rate_plans">
                            <field name="rate_plan_ids">
                                <tree editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="channex_rate_plan_id"/>
                                    <field name="percent"/>
                                    <field name="amount"/>
                                    <field name="min_stay"/>
                                    <field name="currency_id" column_invisible="1"/>
                                    <field name="active" widget="boolean_toggle"/>
                                </tree>
                            </field>
                            <div class="text-muted">
                                One line per rate plan of the room on Channex
                                (standard, non-refundable, weekly…). Each night
                                is priced from the base price and the seasons
                                of the channel, then adjusted by the rate plan.
                            </div>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_cm_listing_list" model="ir.ui.view">
        <field name="name">xb.cm.listing.list</field>
        <field name="model">xb.cm.listing</field>
        <field name="arch" type="xml">
            <tree string="Room mappings">
                <field name="channel_id"/>
                <field name="product_tmpl_id"/>
                <field name="effective_capacity"/>
                <field name="last_pull"/>
                <field name="last_push"/>
            </tree>
        </field>
    </record>

    <record id="view_cm_rate_preview_form" model="ir.ui.view">
        <field name="name">xb.cm.rate.preview.form</field>
        <field name="model">xb.cm.rate.preview</field>
        <field name="arch" type="xml">
            <form string="Rates sent to the channel">
                <group>
                    <group>
                        <field name="listing_id" readonly="1"/>
                        <field name="date_from"/>
                        <field name="days"/>
                    </group>
                    <group>
                        <button name="action_compute" type="object"
                                string="Compute" class="btn-primary"/>
                    </group>
                </group>
                <field name="line_ids" readonly="1">
                    <tree>
                        <field name="rate_plan_id"/>
                        <field name="date_from"/>
                        <field name="date_to"/>
                        <field name="rate"/>
                        <field name="min_stay"/>
                        <field name="closed_to_arrival"/>
                        <field name="stop_sell"/>
                    </tree>
                </field>
                <footer>
                    <button string="Close" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_cm_listing" model="ir.actions.act_window">
        <field name="name">Room mappings</field>
        <field name="res_model">xb.cm.listing</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
