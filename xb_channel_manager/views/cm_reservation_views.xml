<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_cm_reservation_form" model="ir.ui.view">
        <field name="name">xb.cm.reservation.form</field>
        <field name="model">xb.cm.reservation</field>
        <field name="arch" type="xml">
            <form string="OTA reservation">
                <header>
                    <button name="action_import" type="object"
                            string="Import (create order)" class="btn-primary"
                            invisible="state in ('imported', 'cancelled', 'ignored') or kind == 'block'"/>
                    <button name="action_open_order" type="object"
                            string="Open order"
                            invisible="not sale_order_id"/>
                    <button name="action_ignore" type="object"
                            string="Ignore"
                            invisible="state in ('imported', 'ignored', 'cancelled')"/>
                    <button name="action_reset" type="object"
                            string="Reset to new"
                            invisible="state not in ('ignored', 'error', 'conflict')"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="display_label" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Stay">
                            <field name="kind"/>
                            <field name="channel_id"/>
                            <field name="listing_id"/>
                            <field name="product_tmpl_id"/>
                            <field name="date_from"/>
                            <field name="date_to"/>
                            <field name="nights"/>
                        </group>
                        <group string="Guest">
                            <field name="guest_name"/>
                            <field name="guest_email"/>
                            <field name="guest_phone"/>
                            <field name="guests"/>
                            <field name="price_total"/>
                            <field name="currency_id"
                                   groups="base.group_multi_currency"/>
                        </group>
                    </group>
                    <group>
                        <field name="external_uid"/>
                        <field name="name"/>
                        <field name="sale_order_id"/>
                        <field name="error_msg"
                               invisible="not error_msg"/>
                    </group>
                    <group string="Raw payload"
                           invisible="not raw_payload">
                        <field name="raw_payload" nolabel="1"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_cm_reservation_list" model="ir.ui.view">
        <field name="name">xb.cm.reservation.list</field>
        <field name="model">xb.cm.reservation</field>
        <field name="arch" type="xml">
            <list string="OTA reservations"
                  decoration-danger="state in ('conflict', 'error')"
                  decoration-muted="state in ('ignored', 'cancelled')">
                <field name="display_label"/>
                <field name="channel_id"/>
                <field name="product_tmpl_id"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="nights"/>
                <field name="price_total" optional="show"/>
                <field name="sale_order_id" optional="show"/>
                <field name="kind" optional="hide"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'imported'"
                       decoration-info="state == 'new'"
                       decoration-danger="state in ('conflict', 'error')"/>
            </list>
        </field>
    </record>

    <record id="view_cm_reservation_search" model="ir.ui.view">
        <field name="name">xb.cm.reservation.search</field>
        <field name="model">xb.cm.reservation</field>
        <field name="arch" type="xml">
            <search>
                <field name="display_label"/>
                <field name="external_uid"/>
                <field name="guest_name"/>
                <filter string="Needs attention" name="attention"
                        domain="[('state', 'in', ('new', 'conflict', 'error'))]"/>
                <filter string="Imported" name="imported"
                        domain="[('state', '=', 'imported')]"/>
                <filter string="Cancelled" name="cancelled"
                        domain="[('state', '=', 'cancelled')]"/>
                <group>
                    <filter string="Channel" name="by_channel"
                            context="{'group_by': 'channel_id'}"/>
                    <filter string="Room type" name="by_room"
                            context="{'group_by': 'product_tmpl_id'}"/>
                    <filter string="Status" name="by_state"
                            context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_cm_reservation" model="ir.actions.act_window">
        <field name="name">OTA reservations</field>
        <field name="res_model">xb.cm.reservation</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_attention': 1}</field>
    </record>
</odoo>
