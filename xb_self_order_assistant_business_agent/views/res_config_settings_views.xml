<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_xb_va_ba" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.xb.va.business.agent</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="xb_self_order_assistant.res_config_settings_view_form_xb_va"/>
        <field name="arch" type="xml">
            <xpath expr="//label[@for='pos_xb_va_knowledge']/.." position="before">
                <div class="row"><label for="pos_xb_va_ba_kb_source" string="Knowledge from" class="col-lg-4 o_light_label"/><field name="pos_xb_va_ba_kb_source" widget="radio"/></div>
                <div class="row" invisible="pos_xb_va_ba_kb_source == 'own'"><label for="pos_xb_va_ba_account_id" string="WhatsApp agent" class="col-lg-4 o_light_label"/><field name="pos_xb_va_ba_account_id" options="{'no_create': True}" domain="[('xb_ba_enabled', '=', True)]" required="pos_xb_va_ba_kb_source != 'own'"/></div>
            </xpath>
            <xpath expr="//label[@for='pos_xb_va_knowledge']/.." position="attributes">
                <attribute name="invisible">pos_xb_va_ba_kb_source == 'agent'</attribute>
            </xpath>
        </field>
    </record>
</odoo>
