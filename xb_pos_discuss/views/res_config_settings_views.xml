<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_xb_pos_discuss" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.xb.pos.discuss</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <!--
              The native POS settings keep every per-POS block inside the single
              <div invisible="not pos_config_id"> wrapper, so our block shows up
              among the native sections and only once a Point of Sale is picked.
            -->
            <xpath expr="//div[@invisible='not pos_config_id']" position="inside">
                <block title="XUBAX - Discuss" id="xb_pos_discuss_block">
                    <setting id="xb_pos_discuss_setting"
                             string="Discuss in the POS"
                             help="Show a Discuss button in the POS navbar, with a badge for unread messages, so cashiers can chat without leaving the Point of Sale.">
                        <field name="pos_xb_discuss_enabled"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
