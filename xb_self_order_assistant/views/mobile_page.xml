<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- The virtual seller on the customer's phone: the kiosk conversation continues here. -->
    <template id="mobile_page" name="Virtual seller on the phone">
        &lt;!DOCTYPE html&gt;
        <html t-att-lang="lang.replace('_', '-')">
            <head>
                <meta charset="utf-8"/>
                <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover"/>
                <meta name="robots" content="noindex"/>
                <title><t t-esc="company.name"/></title>
                <link rel="stylesheet" href="/xb_self_order_assistant/static/src/mobile/mobile.css"/>
            </head>
            <body>
                <header class="m-head">
                    <img t-if="company.logo" class="m-logo" t-att-src="'/web/image/res.company/%s/logo' % company.id" t-att-alt="company.name"/>
                    <div class="m-who">
                        <img id="m-face" class="m-face" alt=""/>
                        <div><b id="m-name"/><small id="m-status"/></div>
                    </div>
                </header>
                <main id="m-list" class="m-list"/>
                <div id="m-cards" class="m-cards"/>
                <footer class="m-foot">
                    <button id="m-mic" class="m-mic" aria-label="Talk">
                        <svg viewBox="0 0 24 24" width="30" height="30"><rect x="9" y="3" width="6" height="11" rx="3" fill="currentColor"/><path d="M6 11a6 6 0 0 0 12 0M12 17v4" stroke="currentColor" stroke-width="2" fill="none"/></svg>
                    </button>
                    <input id="m-input" class="m-input" type="text"/>
                    <button id="m-send" class="m-send"/>
                </footer>
                <script type="application/json" id="m-boot" t-out="boot"/>
                <script type="module" src="/xb_self_order_assistant/static/src/mobile/mobile.js"/>
            </body>
        </html>
    </template>
</odoo>
