<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="xb_va_avatar_view_kanban" model="ir.ui.view">
        <field name="name">xb.va.avatar.kanban</field>
        <field name="model">xb.va.avatar</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="id"/>
                <templates>
                    <t t-name="card" class="flex-row">
                        <aside class="o_kanban_aside_full">
                            <field name="image_full" widget="image" options="{'size': [120, 180], 'img_class': 'object-fit-cover'}" invisible="not image_full"/>
                            <field name="image" widget="image" options="{'size': [120, 120]}" invisible="image_full"/>
                        </aside>
                        <main class="ms-2">
                            <field name="name" class="fw-bold fs-5"/>
                            <field name="gender"/>
                            <div class="text-muted small mt-1" invisible="not video_idle">Moves (video)</div>
                            <field name="video_idle" invisible="1"/>
                        </main>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <record id="xb_va_avatar_view_form" model="ir.ui.view">
        <field name="name">xb.va.avatar.form</field>
        <field name="model">xb.va.avatar</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <field name="image" widget="image" class="oe_avatar" options="{'size': [128, 128]}"/>
                    <div class="oe_title"><h1><field name="name" placeholder="e.g. Sofía"/></h1></div>
                    <group>
                        <group>
                            <field name="gender" widget="radio" options="{'horizontal': true}"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="sequence"/>
                        </group>
                        <group>
                            <field name="image_full" widget="image" options="{'size': [180, 270]}"/>
                        </group>
                    </group>
                    <group string="Movement (optional)">
                        <field name="video_idle" filename="name"/>
                        <field name="video_talk" filename="name"/>
                    </group>
                    <p class="text-muted">Videos: MP4, vertical, a few seconds, the same framing as the full screen picture, so that one loops into the other.</p>
                </sheet>
            </form>
        </field>
    </record>
    <record id="xb_va_avatar_action" model="ir.actions.act_window">
        <field name="name">Virtual seller avatars</field>
        <field name="res_model">xb.va.avatar</field>
        <field name="view_mode">kanban,form</field>
        <field name="help" type="html"><p class="o_view_nocontent_smiling_face">Add a face for your virtual seller</p><p>A square face picture and, for full screen, a vertical picture or short videos.</p></field>
    </record>
    <menuitem id="menu_xb_va_avatar" name="Virtual seller avatars" action="xb_va_avatar_action"
              parent="point_of_sale.menu_point_config_product" sequence="90" groups="point_of_sale.group_pos_manager"/>
</odoo>
