<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="xb_self_order_assistant.ProductListPage" t-inherit="pos_self_order.ProductListPage" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('product_container')]/section" position="before">
            <div t-if="xbVaPicks.length" class="xb-va-picks-bar">
                <span class="xb-va-picks-title">
                    <t t-esc="selfOrder.config._xb_va.name"/> · <t>selected for you</t>
                </span>
                <button class="xb-va-picks-all" t-on-click="xbVaShowAll">See everything</button>
            </div>
        </xpath>
    </t>
</templates>
