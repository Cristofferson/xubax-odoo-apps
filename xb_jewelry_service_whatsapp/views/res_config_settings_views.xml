<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form_jewelry_wa" model="ir.ui.view">
        <field name="name">res.config.settings.form.jewelry.whatsapp</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id"
               ref="xb_jewelry_service.res_config_settings_view_form_jewelry"/>
        <field name="arch" type="xml">
            <!-- Its own block inside the Jewelry section: telling the customer
                 what is happening with their gold is a subject of its own. -->
            <xpath expr="//app[@name='xb_jewelry_service']" position="inside">
                <block title="Keeping the customer informed"
                       name="xb_jewelry_notify_container">
                <setting string="Tell the customer when it is ready"
                         help="Sends the template the moment the inspection is passed">
                    <field name="xb_wa_notify_ready"/>
                    <div class="mt-2" invisible="not xb_wa_notify_ready">
                        <field name="xb_wa_template_ready_id"/>
                    </div>
                </setting>
                <setting string="Confirm the intake"
                         help="Sends a message when the piece is taken in">
                    <field name="xb_wa_notify_received"/>
                    <div class="mt-2" invisible="not xb_wa_notify_received">
                        <field name="xb_wa_template_received_id"/>
                    </div>
                </setting>
                <setting string="Quote to authorize"
                         help="Template used when the work needs the customer's approval">
                    <field name="xb_wa_template_quote_id"/>
                </setting>
                <setting string="Pickup reminders"
                         help="Days after the piece is ready to chase the customer, comma separated">
                    <field name="xb_wa_reminder_days"/>
                    <div class="mt-2">
                        <field name="xb_wa_template_reminder_id"/>
                    </div>
                </setting>
                <setting string="Fall back to email"
                         help="When WhatsApp is not possible, write to the customer instead.
                               Somebody who just handed over gold should never be left
                               without an acknowledgement.">
                    <field name="xb_email_fallback"/>
                </setting>
                </block>
            </xpath>
        </field>
    </record>

</odoo>
