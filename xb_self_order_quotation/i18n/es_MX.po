#. module: xb_self_order_quotation
#: model:ir.model.fields,field_description:xb_self_order_quotation.field_pos_config__xb_kiosk_quotation
#: model:ir.model.fields,field_description:xb_self_order_quotation.field_res_config_settings__pos_xb_kiosk_quotation
#: model_terms:ir.ui.view,arch_db:xb_self_order_quotation.res_config_settings_view_form_kiosk_quotation
msgid "Quotations from the kiosk"
msgstr "Cotizaciones desde el kiosco"

#. module: xb_self_order_quotation
#: model:ir.model.fields,field_description:xb_self_order_quotation.field_pos_config__xb_kiosk_privacy_url
#: model:ir.model.fields,field_description:xb_self_order_quotation.field_res_config_settings__pos_xb_kiosk_privacy_url
msgid "Privacy notice"
msgstr "Aviso de privacidad"

#. module: xb_self_order_quotation
#: model:ir.model.fields,help:xb_self_order_quotation.field_pos_config__xb_kiosk_quotation
msgid "In the kiosk cart the customer can ask for a quotation, printed on the kiosk's receipt printer and/or sent to their WhatsApp."
msgstr "En el carrito del kiosco el cliente puede pedir una cotización, impresa en la impresora de tickets del kiosco y/o enviada a su WhatsApp."

#. module: xb_self_order_quotation
#: model:ir.model.fields,help:xb_self_order_quotation.field_pos_config__xb_kiosk_privacy_url
msgid "Page with your privacy notice, linked when the customer leaves their name and mobile. Empty: the customer only agrees to be contacted."
msgstr "Página con tu aviso de privacidad, ligada cuando el cliente deja su nombre y celular. Vacío: el cliente solo acepta que lo contacten."

#. module: xb_self_order_quotation
#: model_terms:ir.ui.view,arch_db:xb_self_order_quotation.res_config_settings_view_form_kiosk_quotation
msgid "The customer gets a quotation of the cart, printed on the kiosk's printer and/or by WhatsApp. It is created like the POS quotations (same validity and terms)."
msgstr "El cliente se lleva una cotización del carrito, impresa en la impresora del kiosco y/o por WhatsApp. Se crea como las cotizaciones del TPV (misma vigencia y condiciones)."

#. module: xb_self_order_quotation
#. odoo-javascript
#: code:addons/xb_self_order_quotation/static/src/app/quotation.xml:0
msgid "Get your quotation"
msgstr "¿Quieres tu cotización?"

#. module: xb_self_order_quotation
#. odoo-javascript
#: code:addons/xb_self_order_quotation/static/src/app/quotation.xml:0
msgid "Print it"
msgstr "Imprimirla"

#. module: xb_self_order_quotation
#. odoo-javascript
#: code:addons/xb_self_order_quotation/static/src/app/quotation.xml:0
msgid "Send it to my WhatsApp"
msgstr "Enviarla a mi WhatsApp"

#. module: xb_self_order_quotation
#. odoo-javascript
#: code:addons/xb_self_order_quotation/static/src/app/quotation.xml:0
msgid "Your quotation"
msgstr "Tu cotización"

#. module: xb_self_order_quotation
#. odoo-javascript
#: code:addons/xb_self_order_quotation/static/src/app/quotation.xml:0
msgid "Leave us your mobile and name: your quotation is kept so that we can help you at the counter."
msgstr "Déjanos tu celular y tu nombre: guardamos tu cotización para atenderte en mostrador."

#. module: xb_self_order_quotation
#. odoo-javascript
#: code:addons/xb_self_order_quotation/static/src/app/quotation.xml:0
msgid "Your name"
msgstr "Tu nombre"

#. module: xb_self_order_quotation
#. odoo-javascript
#: code:addons/xb_self_order_quotation/static/src/app/quotation.xml:0
msgid "Mobile number"
msgstr "Celular"

#. module: xb_self_order_quotation
#. odoo-javascript
#: code:addons/xb_self_order_quotation/static/src/app/quotation.xml:0
msgid "Print it here"
msgstr "Imprimirla aquí"

#. module: xb_self_order_quotation
#. odoo-javascript
#: code:addons/xb_self_order_quotation/static/src/app/quotation.xml:0
msgid "I accept the"
msgstr "Acepto el"

#. module: xb_self_order_quotation
#. odoo-javascript
#: code:addons/xb_self_order_quotation/static/src/app/quotation.xml:0
msgid "privacy notice"
msgstr "aviso de privacidad"

#. module: xb_self_order_quotation
#. odoo-javascript
#: code:addons/xb_self_order_quotation/static/src/app/quotation.xml:0
msgid "I agree to be contacted about my quotation."
msgstr "Acepto que me contacten por mi cotización."

#. module: xb_self_order_quotation
#. odoo-javascript
#: code:addons/xb_self_order_quotation/static/src/app/quotation.xml:0
msgid "Preparing your quotation…"
msgstr "Preparando tu cotización…"

#. module: xb_self_order_quotation
#. odoo-javascript
#: code:addons/xb_self_order_quotation/static/src/app/quotation.xml:0
msgid "Get my quotation"
msgstr "Quiero mi cotización"

#. module: xb_self_order_quotation
#. odoo-javascript
#: code:addons/xb_self_order_quotation/static/src/app/quotation.xml:0
msgid "Done,"
msgstr "¡Listo,"

#. module: xb_self_order_quotation
#. odoo-javascript
#: code:addons/xb_self_order_quotation/static/src/app/quotation.xml:0
msgid "is saved."
msgstr "quedó guardada."

#. module: xb_self_order_quotation
#. odoo-javascript
#: code:addons/xb_self_order_quotation/static/src/app/quotation.xml:0
msgid "Pick it up at the counter printer."
msgstr "Recógela en la impresora del mostrador."

#. module: xb_self_order_quotation
#. odoo-javascript
#: code:addons/xb_self_order_quotation/static/src/app/quotation.xml:0
msgid "It could not be printed: ask for it at the counter with its number."
msgstr "No se pudo imprimir: pídela en mostrador con su número."

#. module: xb_self_order_quotation
#. odoo-javascript
#: code:addons/xb_self_order_quotation/static/src/app/quotation.xml:0
msgid "We sent it to your WhatsApp."
msgstr "Te la enviamos a tu WhatsApp."

#. module: xb_self_order_quotation
#. odoo-javascript
#: code:addons/xb_self_order_quotation/static/src/app/quotation.xml:0
msgid "It could not be sent by WhatsApp: ask for it at the counter with its number."
msgstr "No se pudo enviar por WhatsApp: pídela en mostrador con su número."

#. module: xb_self_order_quotation
#. odoo-javascript
#: code:addons/xb_self_order_quotation/static/src/app/quotation.xml:0
msgid "Done"
msgstr "Terminar"

#. module: xb_self_order_quotation
#. odoo-javascript
#: code:addons/xb_self_order_quotation/static/src/app/quotation.xml:0
msgid "The quotation could not be made. Please ask at the counter."
msgstr "No se pudo hacer la cotización. Por favor pregunta en mostrador."

#. module: xb_self_order_quotation
#. odoo-python
#: code:addons/xb_self_order_quotation/controllers/quotation.py:0
msgid "One of the pieces is no longer available."
msgstr "Una de las piezas ya no está disponible."

#. module: xb_self_order_quotation
#. odoo-python
#: code:addons/xb_self_order_quotation/controllers/quotation.py:0
msgid "The kiosk cannot make quotations right now."
msgstr "El kiosco no puede hacer cotizaciones en este momento."

#. module: xb_self_order_quotation
#. odoo-python
#: code:addons/xb_self_order_quotation/controllers/quotation.py:0
msgid "Write your name."
msgstr "Escribe tu nombre."

#. module: xb_self_order_quotation
#. odoo-python
#: code:addons/xb_self_order_quotation/controllers/quotation.py:0
msgid "Write a valid mobile number."
msgstr "Escribe un celular válido."

#. module: xb_self_order_quotation
#. odoo-python
#: code:addons/xb_self_order_quotation/controllers/quotation.py:0
msgid "Your cart is empty."
msgstr "Tu carrito está vacío."

#. module: xb_self_order_quotation
#. odoo-javascript
#: code:addons/xb_self_order_quotation/static/src/app/quotation.xml:0
msgid "Done typing"
msgstr "Ocultar teclado"

#. module: xb_self_order_quotation
#. odoo-javascript
#: code:addons/xb_self_order_quotation/static/src/app/quotation.xml:0
msgid "We found you by your mobile. If it is not you, change the name."
msgstr "Te encontramos por tu celular. Si no eres tú, cambia el nombre."
