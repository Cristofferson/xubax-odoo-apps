<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_kiosk_session_scope" model="ir.rule">
        <field name="name">Analitix Kiosk Session: company and store scope</field>
        <field name="model_id" ref="model_analitix_kiosk_session"/>
        <field name="global" eval="True"/>
        <field name="domain_force">['&amp;', ('company_id', 'in', company_ids), '|', ('store_id', 'in', user.analitix_scope_store_ids.ids), ((0, '=', 1) if user.analitix_scoped else (1, '=', 1))]</field>
    </record>
</odoo>
