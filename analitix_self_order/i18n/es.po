#. module: analitix_self_order
#: model:ir.model.fields,help:analitix_self_order.field_analitix_kiosk_session__use_rate
msgid ""
"100 when the person touched the kiosk. Its average is the share of stops "
"that became a use."
msgstr "100 cuando la persona tocó el kiosco. Su promedio es la proporción de visitas que se volvieron uso."

#. module: analitix_self_order
#: model:ir.model.fields,help:analitix_self_order.field_analitix_kiosk_session__conversion_rate
