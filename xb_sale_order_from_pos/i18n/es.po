#. module: xb_sale_order_from_pos
#: model:mail.template,body_html:xb_sale_order_from_pos.mail_template_pos_quotation_ticket
msgid ""
"<div style=\"margin: 0px; padding: 0px; font-size: 14px;\">\n"
"    <p style=\"margin: 0px; padding: 0px;\">\n"
"        Hello <t t-out=\"object.partner_id.name or ''\">Brandon Freeman</t>,\n"
"        <br/><br/>\n"
"        Thank you for visiting <t t-out=\"object.company_id.name or ''\">YourCompany</t>.\n"
"        Attached is the ticket of your quotation <strong t-out=\"object.name or ''\">S00052</strong>\n"
"        for <strong t-out=\"format_amount(object.amount_total, object.currency_id) or ''\">$ 10.00</strong><t t-if=\"object.validity_date\">, valid until <t t-out=\"format_date(object.validity_date) or ''\">05/05/2021</t></t>.\n"
"        <br/><br/>\n"
"        Any questions? Just reply to this email.\n"
"    </p>\n"
"</div>\n"
"        "
msgstr ""
"<div style=\"margin: 0px; padding: 0px; font-size: 14px;\">\n"
"    <p style=\"margin: 0px; padding: 0px;\">\n"
"        Hola <t t-out=\"object.partner_id.name or ''\">Brandon Freeman</t>,\n"
"        <br/><br/>\n"
"        Gracias por visitarnos en <t t-out=\"object.company_id.name or ''\">YourCompany</t>.\n"
"        Te compartimos el ticket de tu cotización <strong t-out=\"object.name or ''\">S00052</strong>\n"
"        por <strong t-out=\"format_amount(object.amount_total, object.currency_id) or ''\">$ 10.00</strong><t t-if=\"object.validity_date\">, válida hasta el <t t-out=\"format_date(object.validity_date) or ''\">05/05/2021</t></t>.\n"
"        <br/><br/>\n"
"        ¿Tienes alguna duda? Responde a este correo.\n"
"    </p>\n"
"</div>\n"
"        "

