#. module: xb_sale_order_from_pos
#: model:mail.template,body_html:xb_sale_order_from_pos.mail_template_layaway_reminder
msgid ""
"<div style=\"margin: 0px; padding: 0px; font-size: 14px;\">\n"
"    <p style=\"margin: 0px; padding: 0px;\">\n"
"        Hello <t t-out=\"object.partner_id.name or ''\">Brandon Freeman</t>,\n"
"        <br/><br/>\n"
"        Your layaway <strong t-out=\"object.name or ''\">S00052</strong> at <t t-out=\"object.company_id.name or ''\">YourCompany</t> is due on <strong t-out=\"format_date(object.xb_layaway_deadline) or ''\">05/05/2021</strong>.\n"
"        You have paid <t t-out=\"format_amount(object.xb_layaway_paid, object.currency_id) or ''\">$ 100.00</t> and the balance is <strong t-out=\"format_amount(object.amount_unpaid, object.currency_id) or ''\">$ 900.00</strong>.\n"
"        <br/><br/>\n"
"        You can pay it at the shop or online, in one or more payments:\n"
"    </p>\n"
"    <p style=\"margin: 16px 0px;\">\n"
"        <a t-att-href=\"object._xb_layaway_portal_url()\" style=\"background-color: #1f7a4d; padding: 10px 16px; text-decoration: none; color: #fff; border-radius: 6px;\">Pay my layaway</a>\n"
"    </p>\n"
"    <p style=\"margin: 0px; padding: 0px;\" t-if=\"object.xb_layaway_cancel_fee_percent\">\n"
"        If it is not paid by then, the shop keeps <t t-out=\"'%g' % object.xb_layaway_cancel_fee_percent\">10</t>% of what you paid and returns the rest.\n"
"    </p>\n"
"</div>\n"
"        "
msgstr ""
"<div style=\"margin: 0px; padding: 0px; font-size: 14px;\">\n"
"    <p style=\"margin: 0px; padding: 0px;\">\n"
"        Hola <t t-out=\"object.partner_id.name or ''\">Brandon Freeman</t>,\n"
"        <br/><br/>\n"
"        Tu apartado <strong t-out=\"object.name or ''\">S00052</strong> en <t t-out=\"object.company_id.name or ''\">YourCompany</t> vence el <strong t-out=\"format_date(object.xb_layaway_deadline) or ''\">05/05/2021</strong>.\n"
"        Llevas pagado <t t-out=\"format_amount(object.xb_layaway_paid, object.currency_id) or ''\">$ 100.00</t> y el saldo es de <strong t-out=\"format_amount(object.amount_unpaid, object.currency_id) or ''\">$ 900.00</strong>.\n"
"        <br/><br/>\n"
"        Puedes pagarlo en la tienda o en línea, en uno o varios abonos:\n"
"    </p>\n"
"    <p style=\"margin: 16px 0px;\">\n"
"        <a t-att-href=\"object._xb_layaway_portal_url()\" style=\"background-color: #1f7a4d; padding: 10px 16px; text-decoration: none; color: #fff; border-radius: 6px;\">Pagar mi apartado</a>\n"
"    </p>\n"
"    <p style=\"margin: 0px; padding: 0px;\" t-if=\"object.xb_layaway_cancel_fee_percent\">\n"
"        Si no se liquida para entonces, la tienda se queda con el <t t-out=\"'%g' % object.xb_layaway_cancel_fee_percent\">10</t>% de lo que pagaste y te devuelve el resto.\n"
"    </p>\n"
"</div>\n"
"        "

#. module: xb_sale_order_from_pos
#: model:mail.template,body_html:xb_sale_order_from_pos.mail_template_layaway_expired
msgid ""
"<div style=\"margin: 0px; padding: 0px; font-size: 14px;\">\n"
"    <p style=\"margin: 0px; padding: 0px;\">\n"
"        Hello <t t-out=\"object.partner_id.name or ''\">Brandon Freeman</t>,\n"
"        <br/><br/>\n"
"        Your layaway <strong t-out=\"object.name or ''\">S00052</strong> at <t t-out=\"object.company_id.name or ''\">YourCompany</t> was due on <t t-out=\"format_date(object.xb_layaway_deadline) or ''\">05/05/2021</t> and it was not paid in full.\n"
"        Contact us to extend it or to get back <strong t-out=\"format_amount(object.xb_layaway_refund_amount, object.currency_id) or ''\">$ 90.00</strong> of the <t t-out=\"format_amount(object.xb_layaway_paid, object.currency_id) or ''\">$ 100.00</t> you paid.\n"
"        <br/><br/>\n"
"        Any questions? Just reply to this email.\n"
"    </p>\n"
"</div>\n"
"        "
msgstr ""
"<div style=\"margin: 0px; padding: 0px; font-size: 14px;\">\n"
"    <p style=\"margin: 0px; padding: 0px;\">\n"
"        Hola <t t-out=\"object.partner_id.name or ''\">Brandon Freeman</t>,\n"
"        <br/><br/>\n"
"        Tu apartado <strong t-out=\"object.name or ''\">S00052</strong> en <t t-out=\"object.company_id.name or ''\">YourCompany</t> vencía el <t t-out=\"format_date(object.xb_layaway_deadline) or ''\">05/05/2021</t> y no se liquidó.\n"
"        Comunícate con nosotros para ampliarlo o para que te devolvamos <strong t-out=\"format_amount(object.xb_layaway_refund_amount, object.currency_id) or ''\">$ 90.00</strong> de los <t t-out=\"format_amount(object.xb_layaway_paid, object.currency_id) or ''\">$ 100.00</t> que pagaste.\n"
"        <br/><br/>\n"
"        ¿Dudas? Solo responde este correo.\n"
