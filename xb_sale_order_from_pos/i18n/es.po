#. module: xb_sale_order_from_pos
#: model:mail.template,body_html:xb_sale_order_from_pos.mail_template_layaway_autocharge
msgid ""
"<div style=\"margin: 0px; padding: 0px; font-size: 14px;\">\n"
"    <t t-set=\"tx\" t-value=\"object.transaction_ids.filtered(lambda t: t.state == 'done' and t.token_id).sorted('id')[-1:]\"/>\n"
"    <p style=\"margin: 0px; padding: 0px;\">\n"
"        Hello <t t-out=\"object.partner_id.name or ''\">Brandon Freeman</t>,\n"
"        <br/><br/>\n"
"        As agreed, we charged <strong t-out=\"format_amount(tx.amount, object.currency_id) or ''\">$ 200.00</strong> to your card <t t-out=\"tx.token_id.payment_details or ''\">1234</t> for your layaway <strong t-out=\"object.name or ''\">S00052</strong> at <t t-out=\"object.company_id.name or ''\">YourCompany</t>.\n"
"        <br/><br/>\n"
"        You have paid <t t-out=\"format_amount(object.xb_layaway_paid, object.currency_id) or ''\">$ 300.00</t>.\n"
"        <t t-if=\"object.currency_id.compare_amounts(object.amount_unpaid, 0.0) &gt; 0\">\n"
"            The balance is <strong t-out=\"format_amount(object.amount_unpaid, object.currency_id) or ''\">$ 700.00</strong><t t-if=\"object.xb_auto_next_date\"> and the next payment is on <t t-out=\"format_date(object.xb_auto_next_date) or ''\">05/05/2021</t></t>.\n"
"        </t>\n"
"        <t t-else=\"\">\n"
"            <strong>Your layaway is paid in full.</strong> Pick up your purchase at the shop.\n"
"        </t>\n"
"    </p>\n"
"    <p style=\"margin: 16px 0px;\">\n"
"        <a t-att-href=\"object._xb_layaway_portal_url()\" style=\"background-color: #1f7a4d; padding: 10px 16px; text-decoration: none; color: #fff; border-radius: 6px;\">See my layaway</a>\n"
"    </p>\n"
"    <p style=\"margin: 0px; padding: 0px;\">To stop the automatic payments or change the card, just reply to this email.</p>\n"
"</div>\n"
"        "
msgstr ""
"<div style=\"margin: 0px; padding: 0px; font-size: 14px;\">\n"
"    <t t-set=\"tx\" t-value=\"object.transaction_ids.filtered(lambda t: t.state == 'done' and t.token_id).sorted('id')[-1:]\"/>\n"
"    <p style=\"margin: 0px; padding: 0px;\">\n"
"        Hola <t t-out=\"object.partner_id.name or ''\">Brandon Freeman</t>,\n"
"        <br/><br/>\n"
"        Como acordamos, cobramos <strong t-out=\"format_amount(tx.amount, object.currency_id) or ''\">$ 200.00</strong> a tu tarjeta <t t-out=\"tx.token_id.payment_details or ''\">1234</t> por tu apartado <strong t-out=\"object.name or ''\">S00052</strong> en <t t-out=\"object.company_id.name or ''\">YourCompany</t>.\n"
"        <br/><br/>\n"
"        Llevas pagado <t t-out=\"format_amount(object.xb_layaway_paid, object.currency_id) or ''\">$ 300.00</t>.\n"
"        <t t-if=\"object.currency_id.compare_amounts(object.amount_unpaid, 0.0) &gt; 0\">\n"
"            El saldo es de <strong t-out=\"format_amount(object.amount_unpaid, object.currency_id) or ''\">$ 700.00</strong><t t-if=\"object.xb_auto_next_date\"> y el próximo abono es el <t t-out=\"format_date(object.xb_auto_next_date) or ''\">05/05/2021</t></t>.\n"
"        </t>\n"
"        <t t-else=\"\">\n"
"            <strong>Tu apartado quedó liquidado.</strong> Pasa por tu compra a la tienda.\n"
"        </t>\n"
"    </p>\n"
"    <p style=\"margin: 16px 0px;\">\n"
"        <a t-att-href=\"object._xb_layaway_portal_url()\" style=\"background-color: #1f7a4d; padding: 10px 16px; text-decoration: none; color: #fff; border-radius: 6px;\">Ver mi apartado</a>\n"
"    </p>\n"
"    <p style=\"margin: 0px; padding: 0px;\">Para detener los abonos automáticos o cambiar la tarjeta, responde a este correo.</p>\n"
"</div>\n"
"        "

