#. module: xb_sale_order_from_pos
#: model:mail.template,body_html:xb_sale_order_from_pos.mail_template_pos_quotation_ticket
msgid ""
"<div style=\"margin: 0px; padding: 0px; font-size: 14px;\">\n"
"    <p style=\"margin: 0px; padding: 0px;\">\n"
"        Hello <t t-out=\"object.partner_id.name or ''\">Brandon Freeman</t>,\n"
"        <br/><br/>\n"
"        Thank you for visiting <t t-out=\"object.company_id.name or ''\">YourCompany</t>.\n"
"        Attached is the ticket of your quotation <strong t-out=\"object.name or ''\">S00052</strong>\n"
"        for <strong t-out=\"format_amount(object.amount_total, object.currency_id) or ''\">$ 10.00</strong><t t-if=\"object.validity_date\">, valid until <t t-out=\"format_date(object.validity_date) or ''\">05/05/2021</t></t>.\n"
"        <br/><br/>\n"
"        Any questions? Just reply to this email.\n"
"    </p>\n"
"</div>\n"
"        "
msgstr ""

#. module: xb_sale_order_from_pos
#: model:mail.template,body_html:xb_sale_order_from_pos.mail_template_layaway_reminder
msgid ""
"<div style=\"margin: 0px; padding: 0px; font-size: 14px;\">\n"
"    <p style=\"margin: 0px; padding: 0px;\">\n"
"        Hello <t t-out=\"object.partner_id.name or ''\">Brandon Freeman</t>,\n"
"        <br/><br/>\n"
"        Your layaway <strong t-out=\"object.name or ''\">S00052</strong> at <t t-out=\"object.company_id.name or ''\">YourCompany</t> is due on <strong t-out=\"format_date(object.xb_layaway_deadline) or ''\">05/05/2021</strong>.\n"
"        You have paid <t t-out=\"format_amount(object.xb_layaway_paid, object.currency_id) or ''\">$ 100.00</t> and the balance is <strong t-out=\"format_amount(object.amount_unpaid, object.currency_id) or ''\">$ 900.00</strong>.\n"
"        <br/><br/>\n"
"        You can pay it at the shop or online, in one or more payments:\n"
"    </p>\n"
"    <p style=\"margin: 16px 0px;\">\n"
"        <a t-att-href=\"object._xb_layaway_portal_url()\" style=\"background-color: #1f7a4d; padding: 10px 16px; text-decoration: none; color: #fff; border-radius: 6px;\">Pay my layaway</a>\n"
"    </p>\n"
"    <p style=\"margin: 0px; padding: 0px;\" t-if=\"object.xb_layaway_cancel_fee_percent\">\n"
"        If it is not paid by then, the shop keeps <t t-out=\"'%g' % object.xb_layaway_cancel_fee_percent\">10</t>% of what you paid and returns the rest.\n"
"    </p>\n"
"</div>\n"
"        "
msgstr ""

#. module: xb_sale_order_from_pos
#: model:mail.template,body_html:xb_sale_order_from_pos.mail_template_layaway_expired
msgid ""
"<div style=\"margin: 0px; padding: 0px; font-size: 14px;\">\n"
"    <p style=\"margin: 0px; padding: 0px;\">\n"
"        Hello <t t-out=\"object.partner_id.name or ''\">Brandon Freeman</t>,\n"
"        <br/><br/>\n"
"        Your layaway <strong t-out=\"object.name or ''\">S00052</strong> at <t t-out=\"object.company_id.name or ''\">YourCompany</t> was due on <t t-out=\"format_date(object.xb_layaway_deadline) or ''\">05/05/2021</t> and it was not paid in full.\n"
"        Contact us to extend it or to get back <strong t-out=\"format_amount(object.xb_layaway_refund_amount, object.currency_id) or ''\">$ 90.00</strong> of the <t t-out=\"format_amount(object.xb_layaway_paid, object.currency_id) or ''\">$ 100.00</t> you paid.\n"
"        <br/><br/>\n"
"        Any questions? Just reply to this email.\n"
"    </p>\n"
"</div>\n"
"        "
msgstr ""

#. module: xb_sale_order_from_pos
#: model:mail.template,body_html:xb_sale_order_from_pos.mail_template_order_reminder
msgid ""
"<div style=\"margin: 0px; padding: 0px; font-size: 14px;\">\n"
"    <p style=\"margin: 0px; padding: 0px;\">\n"
"        Hello <t t-out=\"object.partner_id.name or ''\">Brandon Freeman</t>,\n"
"        <br/><br/>\n"
"        Your order <strong t-out=\"object.name or ''\">S00052</strong> at <t t-out=\"object.company_id.name or ''\">YourCompany</t> is due for delivery on <strong t-out=\"format_date(object.commitment_date) or ''\">05/05/2021</strong>.\n"
"        You have paid <t t-out=\"format_amount(object.xb_layaway_paid, object.currency_id) or ''\">$ 300.00</t> and the balance is <strong t-out=\"format_amount(object.amount_unpaid, object.currency_id) or ''\">$ 700.00</strong>.\n"
"        <br/><br/>\n"
"        You can pay it at the shop when you pick it up, or online now, in one or more payments:\n"
"    </p>\n"
"    <p style=\"margin: 16px 0px;\">\n"
"        <a t-att-href=\"object._xb_portal_order_url()\" style=\"background-color: #1f7a4d; padding: 10px 16px; text-decoration: none; color: #fff; border-radius: 6px;\">Pay my order</a>\n"
"    </p>\n"
"</div>\n"
"        "
msgstr ""

#. module: xb_sale_order_from_pos
#: model:mail.template,body_html:xb_sale_order_from_pos.mail_template_layaway_autocharge
msgid ""
"<div style=\"margin: 0px; padding: 0px; font-size: 14px;\">\n"
"    <t t-set=\"tx\" t-value=\"object.transaction_ids.filtered(lambda t: t.state == 'done' and t.token_id).sorted('id')[-1:]\"/>\n"
"    <p style=\"margin: 0px; padding: 0px;\">\n"
"        Hello <t t-out=\"object.partner_id.name or ''\">Brandon Freeman</t>,\n"
"        <br/><br/>\n"
"        As agreed, we charged <strong t-out=\"format_amount(tx.amount, object.currency_id) or ''\">$ 200.00</strong> to your card <t t-out=\"tx.token_id.payment_details or ''\">1234</t> for your layaway <strong t-out=\"object.name or ''\">S00052</strong> at <t t-out=\"object.company_id.name or ''\">YourCompany</t>.\n"
"        <br/><br/>\n"
"        You have paid <t t-out=\"format_amount(object.xb_layaway_paid, object.currency_id) or ''\">$ 300.00</t>.\n"
"        <t t-if=\"object.currency_id.compare_amounts(object.amount_unpaid, 0.0) &gt; 0\">\n"
"            The balance is <strong t-out=\"format_amount(object.amount_unpaid, object.currency_id) or ''\">$ 700.00</strong><t t-if=\"object.xb_auto_next_date\"> and the next payment is on <t t-out=\"format_date(object.xb_auto_next_date) or ''\">05/05/2021</t></t>.\n"
"        </t>\n"
"        <t t-else=\"\">\n"
"            <strong>Your layaway is paid in full.</strong> Pick up your purchase at the shop.\n"
"        </t>\n"
"    </p>\n"
"    <p style=\"margin: 16px 0px;\">\n"
"        <a t-att-href=\"object._xb_layaway_portal_url()\" style=\"background-color: #1f7a4d; padding: 10px 16px; text-decoration: none; color: #fff; border-radius: 6px;\">See my layaway</a>\n"
"    </p>\n"
"    <p style=\"margin: 0px; padding: 0px;\">To stop the automatic payments or change the card, just reply to this email.</p>\n"
"</div>\n"
"        "
msgstr ""

