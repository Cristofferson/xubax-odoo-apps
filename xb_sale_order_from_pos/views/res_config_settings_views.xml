<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_xb" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.xb.sale.order.from.pos</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <!--
              ANCHOR (verified against point_of_sale.res_config_settings_view_form in
              Odoo 19.0): the native view uses <app name="point_of_sale"> with all
              per-POS blocks inside the single <div invisible="not pos_config_id">
              wrapper. We append our block there: it sits among the native sections and
              only shows when a POS is selected. Each toggle is its own <setting> (title +
              muted help), so Odoo lays them out in the native two-column grid (col-lg-6).
              Sub-settings are hidden until the master toggle is on.
            -->
            <xpath expr="//div[@invisible='not pos_config_id']" position="inside">
                <block title="XUBAX - Sale Order / Quotation" id="xb_sale_order_block">
                    <!-- Master toggle -->
                    <setting id="xb_enable_sale_order_setting"
                             string="Create Sale Order / Quotation"
                             help="Create quotations, sale orders and layaways (apartados) right from the Point of Sale.">
                        <field name="pos_xb_enable_sale_order"/>
                    </setting>

                    <!-- Document handling -->
                    <setting id="xb_default_so_state_setting"
                             string="Default document state"
                             help="Which document type is pre-selected by default in the POS create dialog. It does not confirm anything on creation."
                             invisible="not pos_xb_enable_sale_order">
                        <field name="pos_xb_default_so_state"/>
                    </setting>
                    <setting id="xb_allow_quotation_setting"
                             string="Allow quotations"
                             help="Let the cashier save the order as a draft quotation to complete online or recover later."
                             invisible="not pos_xb_enable_sale_order">
                        <field name="pos_xb_allow_quotation"/>
                    </setting>
                    <setting id="xb_ask_quotation_delivery_setting"
                             string="Ask how to deliver each quotation"
                             help="When a quotation is created, the cashier chooses whether it is printed, sent by WhatsApp, sent by email, or any combination. What is sent is the same ticket that is printed."
                             invisible="not pos_xb_enable_sale_order or not pos_xb_allow_quotation">
                        <field name="pos_xb_ask_quotation_delivery"/>
                    </setting>
                    <setting id="xb_list_until_delivered_setting"
                             string="Keep paid orders listed until delivered"
                             help="Orders and layaways created here stay in the POS list of orders (Quotation/Order button) while their goods are pending delivery, even when fully paid. Closing an order asks whether the customer takes the piece now; if not, only the balance is charged and the piece stays in stock."
                             invisible="not pos_xb_enable_sale_order">
                        <field name="pos_xb_list_until_delivered"/>
                    </setting>
                    <setting id="xb_differentiate_setting"
                             string="Differentiate Order and Layaway"
                             help="Show separate &quot;Order&quot; and &quot;Layaway&quot; actions instead of a single combined one."
                             invisible="not pos_xb_enable_sale_order">
                        <field name="pos_xb_differentiate_order_layaway"/>
                    </setting>

                    <!-- POS display -->
                    <setting id="xb_show_order_balance_setting"
                             string="Show total &amp; pending balance"
                             help="Display the order total and pending balance next to its reference in the POS order panel."
                             invisible="not pos_xb_enable_sale_order">
                        <field name="pos_xb_show_order_balance"/>
                    </setting>

                    <!-- Receipt -->
                    <setting id="xb_enrich_receipt_setting"
                             string="Detailed order receipt"
                             help="Print the order's product detail, total and pending balance on the receipt."
                             invisible="not pos_xb_enable_sale_order">
                        <field name="pos_xb_enrich_receipt"/>
                    </setting>
                    <setting id="xb_show_partner_ref_setting"
                             string="Show customer reference"
                             help="Print the customer's reference code before their name on the receipt."
                             invisible="not pos_xb_enable_sale_order">
                        <field name="pos_xb_show_partner_ref"/>
                    </setting>
                    <setting id="xb_autoprint_setting"
                             string="Auto-print receipt on create"
                             help="Print the receipt automatically right after the order is created."
                             invisible="not pos_xb_enable_sale_order">
                        <field name="pos_xb_autoprint_on_create"/>
                    </setting>
                    <setting id="xb_duplicate_receipt_setting"
                             string="Print the order receipt in duplicate"
                             help="Print two identical tickets when the order is created: one for the customer, one for the shop. Quotations are always printed once. Requires &quot;Auto-print receipt on create&quot;."
                             invisible="not pos_xb_enable_sale_order or not pos_xb_autoprint_on_create">
                        <field name="pos_xb_duplicate_receipt_on_create"/>
                    </setting>
                    <setting id="xb_show_portal_link_setting"
                             string="Show online portal link on receipt"
                             help="Add a payment QR to the receipt so the customer can review or pay the remaining balance online. Requires &quot;Detailed order receipt&quot;."
                             invisible="not pos_xb_enable_sale_order or not pos_xb_enrich_receipt">
                        <field name="pos_xb_show_portal_link"/>
                    </setting>
                    <setting id="xb_autofactura_qr_setting"
                             string="Self-invoice QR only when settled"
                             help="Show the self-invoice (&quot;Need an invoice?&quot;) QR only on settled/paid tickets, avoiding a double QR on advance tickets. Requires Self-Invoicing."
                             invisible="not pos_xb_enable_sale_order or not point_of_sale_use_ticket_qr_code">
                        <field name="pos_xb_autofactura_qr_paid_only"/>
                    </setting>

                    <!-- Settlement -->
                    <setting id="xb_rounding_product_setting"
                             string="Settle rounding product"
                             help="0% IVA service product used to absorb the per-tax rounding cent when settling an all-16% order, so the CFDI total stays exact."
                             invisible="not pos_xb_enable_sale_order">
                        <field name="pos_xb_rounding_product_id" options="{'no_create': True}"/>
                    </setting>

                    <!-- Document templates per kind (company-wide): different validity /
                         terms for Quotation vs Order vs Layaway. -->
                    <setting id="xb_quotation_template_setting"
                             string="Quotation template (company)"
                             help="Sale Order Template applied to QUOTATIONS created from the POS — sets validity, terms and signature/payment requirements. Company-wide; product lines come from the cart."
                             invisible="not pos_xb_enable_sale_order">
                        <field name="xb_quotation_template_id" options="{'no_create': True}"/>
                    </setting>
                    <setting id="xb_order_template_setting"
                             string="Order template (company)"
                             help="Sale Order Template applied to ORDERS (and the combined Order/Layaway) created from the POS. Company-wide."
                             invisible="not pos_xb_enable_sale_order">
                        <field name="xb_order_template_id" options="{'no_create': True}"/>
                    </setting>
                    <setting id="xb_layaway_template_setting"
                             string="Layaway template (company)"
                             help="Sale Order Template applied to LAYAWAYS created from the POS. Company-wide."
                             invisible="not pos_xb_enable_sale_order">
                        <field name="xb_layaway_template_id" options="{'no_create': True}"/>
                    </setting>
                </block>
                <block title="Layaway and order terms" id="xb_layaway_terms_block"
                       invisible="not pos_xb_enable_sale_order">
                    <setting id="xb_layaway_term_setting" string="Term and down payment"
                             help="Days to pay in full, counted from the day the layaway is made, and the share of the price paid to lay the goods away. Company-wide; each layaway keeps the terms it was made with.">
                        <div class="row mt-2">
                            <label for="xb_layaway_days" class="col-lg-5 o_light_label"/>
                            <field name="xb_layaway_days" class="col-lg-3"/>
                        </div>
                        <div class="row">
                            <label for="xb_layaway_down_percent" class="col-lg-5 o_light_label"/>
                            <field name="xb_layaway_down_percent" class="col-lg-3"/>
                        </div>
                    </setting>
                    <setting id="xb_layaway_payment_setting" string="Payments and cancellation"
                             help="Smallest payment after the down payment (a payment that settles the balance is always accepted) and what the shop keeps of the payments when the layaway expires unpaid.">
                        <div class="row mt-2">
                            <label for="xb_layaway_min_payment" class="col-lg-5 o_light_label"/>
                            <field name="xb_layaway_min_payment" class="col-lg-3"/>
                        </div>
                        <div class="row">
                            <label for="xb_layaway_cancel_fee_percent" class="col-lg-5 o_light_label"/>
                            <field name="xb_layaway_cancel_fee_percent" class="col-lg-3"/>
                        </div>
                    </setting>
                    <setting id="xb_layaway_notify_setting" string="Customer reminders"
                             help="Before the deadline the customer gets an email with the balance and the link to pay it online. It is an Odoo automation rule: change the days or the email there. A notice is also emailed when the layaway expires.">
                        <field name="xb_layaway_notify_customer"/>
                        <div class="mt-2">
                            <button name="action_xb_layaway_reminder_rule" type="object" string="Reminder rule" icon="oi-arrow-right" class="btn-link"/>
                        </div>
                    </setting>
                    <setting id="xb_order_terms_setting" string="Orders: minimum down payment"
                             help="Share of the price an order made at the register (a special order) needs as its first payment; a payment of the whole order is always accepted. 0 = any down payment. Before the delivery date the customer gets an email with the balance and the link to pay it online (an Odoo automation rule).">
                        <div class="row mt-2">
                            <label for="xb_order_down_percent" class="col-lg-5 o_light_label"/>
                            <field name="xb_order_down_percent" class="col-lg-3"/>
                        </div>
                        <div class="mt-2">
                            <button name="action_xb_order_reminder_rule" type="object" string="Order reminder rule" icon="oi-arrow-right" class="btn-link"/>
                        </div>
                    </setting>
                    <setting id="xb_layaway_warn_setting" string="Protect laid-away goods"
                             help="Before selling a piece that is laid away for another customer, the Point of Sale shows whose layaway it is and asks the cashier to confirm.">
                        <field name="xb_layaway_warn_reserved"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
