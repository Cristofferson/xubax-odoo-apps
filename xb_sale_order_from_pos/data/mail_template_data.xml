<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!--
      Email that takes a POS quotation to the customer. It carries the TICKET, the
      same image the POS prints, attached by sale.order._xb_pos_send_email. There is
      deliberately no report on this template: the customer gets the ticket the shop
      hands over on paper, not the formal quotation PDF.
    -->
    <record id="mail_template_pos_quotation_ticket" model="mail.template">
        <field name="name">Point of Sale: Quotation ticket</field>
        <field name="description">Sent from the Point of Sale with the quotation ticket attached</field>
        <field name="model_id" ref="sale.model_sale_order"/>
        <field name="subject">{{ object.company_id.name }} - Quotation {{ object.name }}</field>
        <field name="email_from">{{ (object.user_id.email_formatted or object.company_id.email_formatted or user.email_formatted) }}</field>
        <field name="partner_to" eval="False"/>
        <field name="use_default_to" eval="True"/>
        <field name="lang">{{ object.partner_id.lang }}</field>
        <field name="auto_delete" eval="True"/>
        <field name="body_html" type="html">
<div style="margin: 0px; padding: 0px; font-size: 14px;">
    <p style="margin: 0px; padding: 0px;">
        Hello <t t-out="object.partner_id.name or ''">Brandon Freeman</t>,
        <br/><br/>
        Thank you for visiting <t t-out="object.company_id.name or ''">YourCompany</t>.
        Attached is the ticket of your quotation <strong t-out="object.name or ''">S00052</strong>
        for <strong t-out="format_amount(object.amount_total, object.currency_id) or ''">$ 10.00</strong><t t-if="object.validity_date">, valid until <t t-out="format_date(object.validity_date) or ''">05/05/2021</t></t>.
        <br/><br/>
        Any questions? Just reply to this email.
    </p>
</div>
        </field>
    </record>
</odoo>
