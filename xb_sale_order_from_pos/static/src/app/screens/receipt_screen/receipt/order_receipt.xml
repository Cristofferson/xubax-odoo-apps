<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <!--
      XUBAX - Phase 3 receipt polish. All Sale-Order blocks only render when the
      receipt's order carries SO data (Order.export_for_printing ▸ xbSaleOrder) and
      xb_enrich_receipt is on, so regular POS receipts are untouched. Sizing lives in
      order_receipt.css. Strings are translated to es_MX via i18n/es_MX.po.
    -->

    <t t-inherit="point_of_sale.OrderReceipt" t-inherit-mode="extension">
        <!-- (e) Sale-Order block AFTER the payment lines + change, so the POS
             payments stay right under the TOTAL and our SO summary reads as a
             distinct, final section. -->
        <xpath expr="//div[hasclass('receipt-change')]" position="after">
            <t t-set="xbSo" t-value="props.data.xbSaleOrder"/>
            <t t-if="props.data.xbEnrich">
                <!-- (b) The Total/Advance/Balance summary is redundant when there was
                     no advance (paid == 0): the printed TOTAL already says it all. -->
                <t t-if="xbSo.paid &gt; 0">
                    <div style="border-top:1px dashed #000;margin:6px 0 2px 0;"/>
                    <!-- (g) Settlement ticket (balance reaches 0) is titled distinctly. -->
                    <div class="xb-so-summary-title" style="font-size:11px;opacity:.8;">
                        <t t-if="xbSo.balance &lt;= 0">Settlement payment</t>
                        <t t-else="">Order summary</t>
                    </div>
                    <div class="xb-so-summary">
                        <div class="pos-receipt-amount">
                            <span>Total <t t-esc="xbSo.name"/></span>
                            <span t-esc="props.formatCurrency(xbSo.total)" class="pos-receipt-right-align"/>
                        </div>
                        <!-- (h) Component breakdown = the SO's own product lines. Only on
                             the ADVANCE ticket (balance &gt; 0). -->
                        <table t-if="props.data.xbSaleDetails and xbSo.balance &gt; 0" class="xb-so-details">
                            <tr t-foreach="props.data.xbSaleDetails" t-as="xbDet" t-key="xbDet_index">
                                <td class="text-truncate"><t t-esc="xbDet.product_uom_qty"/>x</td>
                                <td class="text-truncate product-name"><t t-esc="xbDet.product_name"/></td>
                                <td class="text-truncate">: </td>
                                <td class="text-truncate"><t t-esc="props.formatCurrency(xbDet.total)"/></td>
                            </tr>
                        </table>
                        <div class="pos-receipt-amount">
                            <span>Down payment / Paid</span>
                            <span t-esc="props.formatCurrency(xbSo.paid)" class="pos-receipt-right-align"/>
                        </div>
                        <div class="pos-receipt-amount fw-bolder">
                            <span>Balance due</span>
                            <span t-esc="props.formatCurrency(xbSo.balance)" class="pos-receipt-right-align"/>
                        </div>
                    </div>
                </t>

                <!-- (c) Payment QR: only while there is still a balance to pay (>0). -->
                <div t-if="props.data.xbPortalQr" class="xb-so-portal pt-3 text-center">
                    <div>Pay or review your order online:</div>
                    <img t-att-src="props.data.xbPortalQr" class="xb-so-portal-qr"
                         alt="Order portal QR"/>
                </div>
            </t>
        </xpath>

        <!-- (PRIORITY) Cash-rounding consistency: the native "Rounding"/"To Pay" lines
             depend on what was tendered. Ours are derived from the TOTAL itself, so
             Total + Rounding = To Pay on every cash-rounded ticket. -->
        <xpath expr="//t[@t-if='props.data.rounding_applied']" position="replace">
            <t t-if="props.data.xbRounding">
                <div class="pos-receipt-amount receipt-rounding">
                    <span class="label-rounding">Rounding</span>
                    <span t-esc="props.formatCurrency(props.data.xbRounding.amount)" class="pos-receipt-right-align"/>
                </div>
                <div class="pos-receipt-amount receipt-to-pay">
                    To Pay
                    <span t-esc="props.formatCurrency(props.data.xbRounding.toPay)" class="pos-receipt-right-align"/>
                </div>
            </t>
        </xpath>
    </t>

    <!-- ReceiptHeader: type header "<TYPE> <SO number>" under the logo, the delivery
         date / layaway deadline, the customer (ref before name, bold) and the fiscal
         entity's RFC. -->
    <t t-inherit="point_of_sale.ReceiptHeader" t-inherit-mode="extension">
        <xpath expr="//img[hasclass('pos-receipt-logo')]" position="after">
            <t t-set="xbSoHdr" t-value="props.data.xbSaleOrder"/>
            <!-- (a) Title by STATE: a confirmed quotation (state 'sale') prints ORDER;
                 only draft/sent quotations print QUOTATION. Order/Layaway are fixed. -->
            <t t-set="xbKind"
               t-value="xbSoHdr and (xbSoHdr.type === 'quotation' ? (xbSoHdr.state === 'sale' ? 'order' : 'quotation') : xbSoHdr.type)"/>
            <div t-if="xbSoHdr and xbSoHdr.type" class="xb-so-type text-center">
                <span class="xb-so-type-word">
                    <t t-if="xbKind === 'quotation'">QUOTATION</t>
                    <t t-elif="xbKind === 'order'">ORDER</t>
                    <t t-elif="xbKind === 'layaway'">LAYAWAY</t>
                    <t t-else="">ORDER / LAYAWAY</t>
                </span>
                <t t-esc="' ' + xbSoHdr.name"/>
            </div>
            <div t-if="xbSoHdr and xbSoHdr.deliveryDate" class="xb-so-delivery-date text-center fw-bolder">
                Delivery date: <t t-esc="xbSoHdr.deliveryDate"/>
            </div>
            <div t-if="xbSoHdr and xbSoHdr.layawayDeadline" class="xb-so-layaway-deadline text-center fw-bolder">
                Pay the balance by: <t t-esc="xbSoHdr.layawayDeadline"/>
            </div>
        </xpath>

        <xpath expr="//div[hasclass('pos-receipt-contact')]" position="inside">
            <div t-if="props.data.xbPartnerName" class="xb-so-partner fw-bolder">
                <t t-if="props.data.xbSaleOrder.partnerRef"><t t-esc="props.data.xbSaleOrder.partnerRef"/> — </t>
                <t t-esc="props.data.xbPartnerName"/>
            </div>
        </xpath>

        <!-- (i) The RFC line also shows for a branch whose own VAT is empty (then the
             parent's, via xb_cfdi_emisor_rfc). The value comes from our vatText. -->
        <xpath expr="//t[@t-if='props.data.company.vat']" position="attributes">
            <attribute name="t-if">props.data.company.vat or props.data.company.xb_cfdi_emisor_rfc</attribute>
        </xpath>
    </t>
</templates>
