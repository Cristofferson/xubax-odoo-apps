<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_showroom_kiosk" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.showroom.kiosk</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="pos_self_order.res_config_settings_view_form_menu"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='self_ordering_section']" position="inside">
                <setting string="Showroom wall" invisible="pos_self_ordering_mode != 'kiosk'"
                         help="Customers can show a piece on this wall from the kiosk. Only products ticked 'Show on the showroom wall'.">
                    <field name="pos_xb_showroom_screen_id" options="{'no_create': True}"/>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
