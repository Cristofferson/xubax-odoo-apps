<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_kiosk_rawbt" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.xb.kiosk.rawbt</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="pos_self_order.res_config_settings_view_form_menu"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='self_ordering_section']" position="inside">
                <setting string="Kiosk printer through RawBT" invisible="pos_self_ordering_mode != 'kiosk'"
                         help="The kiosk prints its tickets on the printer of the tablet (USB or Bluetooth) through the RawBT app (Android), instead of the Epson printer.">
                    <field name="pos_xb_rawbt"/>
                    <div class="content-group mt-2" invisible="not pos_xb_rawbt">
                        <div class="row">
                            <label for="pos_xb_rawbt_paper" class="col-lg-4 o_light_label"/>
                            <field name="pos_xb_rawbt_paper"/>
                        </div>
                        <div class="row">
                            <label for="pos_xb_rawbt_method" class="col-lg-4 o_light_label"/>
                            <field name="pos_xb_rawbt_method"/>
                        </div>
                        <div class="row">
                            <label for="pos_xb_rawbt_test_url" class="col-lg-4 o_light_label"/>
                            <field name="pos_xb_rawbt_test_url" widget="url" readonly="1"/>
                        </div>
                    </div>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
