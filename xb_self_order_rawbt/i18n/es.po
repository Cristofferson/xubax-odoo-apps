#. module: xb_self_order_rawbt
#: model_terms:ir.ui.view,arch_db:xb_self_order_rawbt.res_config_settings_view_form_kiosk_rawbt
msgid ""
"The kiosk prints its tickets on the printer of the tablet (USB or Bluetooth)"
" through the RawBT app (Android), instead of the Epson printer."
msgstr "El kiosco imprime sus tickets en la impresora de la tablet (USB o Bluetooth) por medio de la app RawBT (Android), en lugar de la impresora Epson."

#. module: xb_self_order_rawbt
#: model:ir.model.fields,help:xb_self_order_rawbt.field_pos_config__xb_rawbt
#: model:ir.model.fields,help:xb_self_order_rawbt.field_res_config_settings__pos_xb_rawbt
msgid ""
"The kiosk prints its tickets through the RawBT app of the tablet (Android) "
"on the printer RawBT is connected to (USB, Bluetooth or network), instead of"
" the Epson ePOS printer."
msgstr "El kiosco imprime sus tickets por medio de la app RawBT de la tablet (Android) en la impresora a la que esté conectada RawBT (USB, Bluetooth o red), en lugar de la impresora Epson ePOS."

