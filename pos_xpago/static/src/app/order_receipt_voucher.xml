<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!-- The card voucher of XPago payments, after the footer of the receipt. It carries the card, so the
         receipt info of the same payment is not printed again. -->
    <t t-name="pos_xpago.OrderReceipt" t-inherit="point_of_sale.OrderReceipt" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('after-footer')]//t[@t-if='line.ticket']" position="attributes">
            <attribute name="t-if">line.ticket and !line.xpago_voucher</attribute>
        </xpath>
        <xpath expr="//div[hasclass('after-footer')]" position="inside">
            <t t-foreach="props.data.paymentlines" t-as="line" t-key="line_index">
                <t t-set="voucher" t-value="line.xpago_voucher"/>
                <div t-if="voucher" class="xpago-voucher text-start mt-3 pt-2" style="border-top: 1px dashed currentColor; font-size: 85%;">
                    <div class="text-center fw-bolder">CARD SALE</div>
                    <div class="d-flex justify-content-between">
                        <span><t t-esc="voucher.brand"/> **** <t t-esc="voucher.card_no"/></span>
                        <span t-esc="voucher.funding"/>
                    </div>
                    <div t-if="voucher.bank">Bank: <t t-esc="voucher.bank"/></div>
                    <div t-if="voucher.authorization">Authorization: <t t-esc="voucher.authorization"/></div>
                    <div t-if="voucher.reference">Reference: <t t-esc="voucher.reference"/></div>
                    <div t-if="voucher.operation" class="text-break">Operation: <t t-esc="voucher.operation"/></div>
                    <div t-if="voucher.entry_mode">Entry mode: <t t-esc="voucher.entry_mode"/></div>
                    <div t-if="voucher.merchant">Merchant number: <t t-esc="voucher.merchant"/></div>
                    <div t-if="props.data.date">Date: <t t-esc="props.data.date"/></div>
                    <div t-if="voucher.terms">Months without interest: <t t-esc="voucher.terms"/></div>
                    <div t-if="voucher.tip" class="d-flex justify-content-between">
                        <span>Tip</span>
                        <span t-esc="props.formatCurrency(voucher.tip)"/>
                    </div>
                    <div class="d-flex justify-content-between fw-bolder">
                        <span>Amount</span>
                        <span t-esc="props.formatCurrency(line.amount)"/>
                    </div>
                    <div class="mt-2" style="white-space: pre-line; font-size: 90%;" t-esc="voucher.legend"/>
                    <div t-if="voucher.signature" class="text-center mt-4">
                        <div style="border-top: 1px solid currentColor; margin: 0 10%;"/>
                        <div>Customer's signature</div>
                    </div>
                </div>
            </t>
        </xpath>
    </t>

</templates>
