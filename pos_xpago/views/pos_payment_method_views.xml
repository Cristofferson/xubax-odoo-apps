<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="pos_payment_method_view_form" model="ir.ui.view">
        <field name="name">pos.payment.method.form.inherit.xpago</field>
        <field name="model">pos.payment.method</field>
        <field name="inherit_id" ref="point_of_sale.pos_payment_method_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='use_payment_terminal']" position="after">
                <field name="xpago_provider_id" invisible="use_payment_terminal != 'xpago'" required="use_payment_terminal == 'xpago'"
                       options="{'no_create': True}"/>
                <field name="xpago_terminal_serial" placeholder="N950-123456789" invisible="use_payment_terminal != 'xpago'"
                       required="use_payment_terminal == 'xpago'"/>
                <field name="xpago_open_terminal_app" invisible="use_payment_terminal != 'xpago'"/>
            </xpath>
        </field>
    </record>
</odoo>
