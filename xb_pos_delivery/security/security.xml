<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="xb_delivery_account_company_rule" model="ir.rule">
        <field name="name">Delivery accounts: multi-company</field>
        <field name="model_id" ref="model_xb_delivery_account"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
    <record id="xb_delivery_log_company_rule" model="ir.rule">
        <field name="name">Delivery logs: multi-company</field>
        <field name="model_id" ref="model_xb_delivery_log"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
</odoo>
