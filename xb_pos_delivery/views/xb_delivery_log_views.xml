<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="xb_delivery_log_view_list" model="ir.ui.view">
        <field name="name">xb.delivery.log.list</field>
        <field name="model">xb.delivery.log</field>
        <field name="arch" type="xml">
            <list create="false" edit="false">
                <field name="create_date"/>
                <field name="account_id"/>
                <field name="direction"/>
                <field name="event"/>
                <field name="success" widget="boolean_toggle" readonly="1"/>
                <field name="message"/>
            </list>
        </field>
    </record>

    <record id="xb_delivery_log_view_form" model="ir.ui.view">
        <field name="name">xb.delivery.log.form</field>
        <field name="model">xb.delivery.log</field>
        <field name="arch" type="xml">
            <form create="false" edit="false">
                <sheet>
                    <group>
                        <group>
                            <field name="create_date"/>
                            <field name="account_id"/>
                            <field name="direction"/>
                        </group>
                        <group>
                            <field name="event"/>
                            <field name="success"/>
                            <field name="message"/>
                        </group>
                    </group>
                    <field name="payload" widget="code" options="{'mode': 'json'}"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="xb_delivery_log_view_search" model="ir.ui.view">
        <field name="name">xb.delivery.log.search</field>
        <field name="model">xb.delivery.log</field>
        <field name="arch" type="xml">
            <search>
                <field name="event"/>
                <field name="account_id"/>
                <filter string="Errors" name="errors" domain="[('success', '=', False)]"/>
                <filter string="Incoming" name="incoming" domain="[('direction', '=', 'in')]"/>
                <filter string="Outgoing" name="outgoing" domain="[('direction', '=', 'out')]"/>
                <group>
                    <filter string="Account" name="group_account"
                            context="{'group_by': 'account_id'}"/>
                    <filter string="Event" name="group_event"
                            context="{'group_by': 'event'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="xb_delivery_log_action" model="ir.actions.act_window">
        <field name="name">Delivery Logs</field>
        <field name="res_model">xb.delivery.log</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
