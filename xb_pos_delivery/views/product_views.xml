<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_inherit_xb" model="ir.ui.view">
        <field name="name">product.template.form.xb.delivery</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="point_of_sale.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='pos']" position="inside">
                <group string="Food Delivery Platforms" name="xb_delivery">
                    <field name="xb_delivery_status_ids" nolabel="1" colspan="2">
                        <list editable="bottom">
                            <field name="account_id"/>
                            <field name="is_available" widget="boolean_toggle"
                                   string="Available (not sold out)"/>
                        </list>
                    </field>
                </group>
            </xpath>
        </field>
    </record>

    <record id="xb_delivery_item_status_action" model="ir.actions.act_window">
        <field name="name">Sold-out Control</field>
        <field name="res_model">xb.delivery.item.status</field>
        <field name="view_mode">list</field>
    </record>

    <record id="xb_delivery_item_status_view_list" model="ir.ui.view">
        <field name="name">xb.delivery.item.status.list</field>
        <field name="model">xb.delivery.item.status</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="account_id"/>
                <field name="product_tmpl_id"/>
                <field name="is_available" widget="boolean_toggle"/>
            </list>
        </field>
    </record>
</odoo>
