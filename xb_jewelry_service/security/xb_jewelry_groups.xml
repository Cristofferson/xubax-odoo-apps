<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Odoo 19 groups hang from a privilege, not from a module category. -->
    <record id="res_groups_privilege_jewelry" model="res.groups.privilege">
        <field name="name">Jewelry Workshop</field>
        <field name="category_id" ref="base.module_category_supply_chain"/>
        <field name="description">Manage customer pieces, repairs and jewelers.</field>
        <field name="sequence">55</field>
    </record>

    <record id="group_jewelry_counter" model="res.groups">
        <field name="name">Counter</field>
        <field name="privilege_id" ref="res_groups_privilege_jewelry"/>
        <field name="comment">Receives pieces, records photos and delivers finished work.</field>
    </record>

    <record id="group_jewelry_workshop" model="res.groups">
        <field name="name">Workshop</field>
        <field name="privilege_id" ref="res_groups_privilege_jewelry"/>
        <field name="implied_ids" eval="[(4, ref('group_jewelry_counter'))]"/>
        <field name="comment">Assigns jewelers, dispatches pieces and runs quality control.</field>
    </record>

    <record id="group_jewelry_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="privilege_id" ref="res_groups_privilege_jewelry"/>
        <field name="implied_ids" eval="[(4, ref('group_jewelry_workshop'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        <field name="comment">Configures the workshop and settles jeweler payments.</field>
    </record>

    <record id="xb_jewelry_piece_company_rule" model="ir.rule">
        <field name="name">Jewelry piece: multi-company</field>
        <field name="model_id" ref="model_xb_jewelry_piece"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        <field name="global" eval="True"/>
    </record>

    <!-- Hand-overs and settlements name a jeweler and what they are paid, so
         they stay inside the company that agreed the rate. -->
    <record id="xb_jewelry_dispatch_company_rule" model="ir.rule">
        <field name="name">Workshop dispatch: multi-company</field>
        <field name="model_id" ref="model_xb_jewelry_dispatch"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        <field name="global" eval="True"/>
    </record>

    <record id="xb_jeweler_settlement_company_rule" model="ir.rule">
        <field name="name">Jeweler settlement: multi-company</field>
        <field name="model_id" ref="model_xb_jeweler_settlement"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        <field name="global" eval="True"/>
    </record>

    <record id="xb_jeweler_rate_company_rule" model="ir.rule">
        <field name="name">Jeweler rate: multi-company</field>
        <field name="model_id" ref="model_xb_jeweler_rate"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        <field name="global" eval="True"/>
    </record>

</odoo>
