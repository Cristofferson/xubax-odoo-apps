<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="xb_metal_purity_view_list" model="ir.ui.view">
        <field name="name">xb.metal.purity.list</field>
        <field name="model">xb.metal.purity</field>
        <field name="arch" type="xml">
            <list string="Metal Purity" editable="bottom">
                <field name="attribute_value_id"/>
                <field name="karat"/>
                <field name="purity"/>
                <field name="is_precious"/>
                <field name="active" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="xb_metal_purity_action" model="ir.actions.act_window">
        <field name="name">Metal Purity</field>
        <field name="res_model">xb.metal.purity</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Give each metal a number</p>
            <p>
                Karat written as text cannot be used for arithmetic. Mapping every metal
                value to its fineness is what makes pure metal weight, and the scrap
                reconciliation with your jewelers, possible.
            </p>
        </field>
    </record>

</odoo>
