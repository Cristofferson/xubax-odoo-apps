<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <record id="seq_xb_jewelry_piece" model="ir.sequence">
        <field name="name">Jewelry Piece</field>
        <field name="code">xb.jewelry.piece</field>
        <field name="prefix">PCE/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="seq_xb_jewelry_dispatch" model="ir.sequence">
        <field name="name">Workshop Dispatch</field>
        <field name="code">xb.jewelry.dispatch</field>
        <field name="prefix">WSD/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="seq_xb_jeweler_settlement" model="ir.sequence">
        <field name="name">Jeweler Settlement</field>
        <field name="code">xb.jeweler.settlement</field>
        <field name="prefix">STL/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

</odoo>
