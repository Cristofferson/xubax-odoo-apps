<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="whatsapp_account_view_form_xb_business_agent" model="ir.ui.view">
        <field name="name">whatsapp.account.view.form.xb.business.agent</field>
        <field name="model">whatsapp.account</field>
        <field name="inherit_id" ref="whatsapp.whatsapp_account_view_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button name="action_xb_ba_open_jobs" type="object" class="oe_stat_button" icon="fa-commenting-o"
                        invisible="not xb_ba_enabled and not xb_ba_job_count">
                    <field name="xb_ba_job_count" string="AI Agent" widget="statinfo"/>
                </button>
            </div>
            <xpath expr="//sheet" position="inside">
                <div class="o_horizontal_separator mt-4 mb-3 text-uppercase fw-bolder small">
                    AI Agent
                </div>
                <div class="alert alert-warning mb-3" role="status" invisible="not xb_ba_enabled or not xb_ba_shadow">
                    <b>Rehearsal mode:</b> the agent sends NOTHING to the customer; it leaves its answer as an internal note in the conversation.
                </div>
                <div class="row mt16 o_settings_container" id="xb_ba_main">
                    <setting help="The agent answers the messages that reach this number.">
                        <field name="xb_ba_enabled"/>
                    </setting>
                    <setting help="Answers as internal notes, not sent. Turn it off when you are happy with them.">
                        <field name="xb_ba_shadow"/>
                    </setting>
                    <setting help="For testing: only answer these numbers, separated by commas. Empty = everyone.">
                        <field name="xb_ba_only_numbers" placeholder="443 123 4567, 55 7013 1853"/>
                    </setting>
                    <setting help="Get it at console.anthropic.com → API Keys. Set a monthly spend limit there." groups="base.group_system">
                        <field name="xb_ba_api_key" password="True"/>
                    </setting>
                    <setting help="To turn the customer's voice notes into text (the audio is sent to OpenAI)." groups="base.group_system">
                        <field name="xb_ba_openai_key" password="True"/>
                    </setting>
                    <setting help="Opus answers best; Sonnet costs half; Haiku is the cheapest.">
                        <field name="xb_ba_model"/>
                    </setting>
                    <setting help="How much it thinks before answering.">
                        <field name="xb_ba_effort"/>
                    </setting>
                    <setting help="If someone from the team replies, the agent stays quiet for these hours in that conversation. Type #agente or #bot to hand it back.">
                        <field name="xb_ba_pause_hours"/>
                    </setting>
                    <setting help="If the customer insists while waiting for a person, they get this (at most every 2 h) and the team is reminded.">
                        <field name="xb_ba_hold_message"/>
                    </setting>
                </div>
                <div class="row mt16 o_settings_container" id="xb_ba_people">
                    <setting help="They get what the agent hands over to a person; new leads are shared out in turns.">
                        <field name="xb_ba_user_ids" widget="many2many_tags"/>
                    </setting>
                    <setting>
                        <field name="xb_ba_team_id"/>
                    </setting>
                    <setting help="Appointment types of the Appointments app the agent can book: hours, staff and duration come from there.">
                        <field name="xb_ba_appointment_type_ids" widget="many2many_tags"/>
                    </setting>
                    <setting help="How the agent introduces the business. Empty = the company name.">
                        <field name="xb_ba_company_name"/>
                    </setting>
                </div>
                <label for="xb_ba_instructions" string="Agent instructions" class="fw-bold mt-3"/>
                <field name="xb_ba_instructions" nolabel="1" placeholder="How the agent should behave..."/>
            </xpath>
        </field>
    </record>
</odoo>
