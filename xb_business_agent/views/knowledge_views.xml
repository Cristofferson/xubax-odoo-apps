<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_xb_business_knowledge_list" model="ir.ui.view">
        <field name="name">xb.business.knowledge.list</field>
        <field name="model">xb.business.knowledge</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="kind"/>
                <field name="name"/>
                <field name="account_ids" widget="many2many_tags" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_xb_business_knowledge_form" model="ir.ui.view">
        <field name="name">xb.business.knowledge.form</field>
        <field name="model">xb.business.knowledge</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="kind"/>
                        <field name="account_ids" widget="many2many_tags"/>
                        <field name="active"/>
                    </group>
                    <field name="content" placeholder="Write it as you would explain it to a customer. The agent only says what is written here."/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_xb_business_knowledge_search" model="ir.ui.view">
        <field name="name">xb.business.knowledge.search</field>
        <field name="model">xb.business.knowledge</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="content"/>
                <group>
                    <filter name="by_kind" string="Type" context="{'group_by': 'kind'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_xb_business_knowledge" model="ir.actions.act_window">
        <field name="name">Knowledge base</field>
        <field name="res_model">xb.business.knowledge</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_by_kind': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Teach the agent what you offer</p>
            <p>Services, prices, hours, FAQs and rules. The agent never makes
               things up: it only uses what is written here.</p>
        </field>
    </record>
</odoo>
