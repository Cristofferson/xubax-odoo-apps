<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_xb_business_job_list" model="ir.ui.view">
        <field name="name">xb.business.job.list</field>
        <field name="model">xb.business.job</field>
        <field name="arch" type="xml">
            <list create="0" decoration-danger="state == 'error'" decoration-muted="state == 'skipped'">
                <field name="create_date" string="Date"/>
                <field name="whatsapp_number"/>
                <field name="partner_id"/>
                <field name="reply"/>
                <field name="state" widget="badge" decoration-success="state == 'done'" decoration-info="state == 'draft'" decoration-danger="state == 'error'"/>
                <field name="cost_usd" sum="Total" optional="show"/>
                <field name="duration" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_xb_business_job_form" model="ir.ui.view">
        <field name="name">xb.business.job.form</field>
        <field name="model">xb.business.job</field>
        <field name="arch" type="xml">
            <form create="0">
                <header>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="channel_id"/>
                            <field name="whatsapp_number"/>
                            <field name="partner_id"/>
                            <field name="reason" invisible="not reason"/>
                        </group>
                        <group>
                            <field name="model_name"/>
                            <field name="cost_usd"/>
                            <field name="duration"/>
                            <field name="attempts"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Reply" name="reply">
                            <field name="reply" nolabel="1"/>
                        </page>
                        <page string="What it did" name="log">
                            <field name="log" nolabel="1"/>
                        </page>
                        <page string="Usage" name="usage">
                            <group>
                                <field name="input_tokens"/>
                                <field name="output_tokens"/>
                                <field name="cache_read_tokens"/>
                                <field name="cache_write_tokens"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_xb_business_job_search" model="ir.ui.view">
        <field name="name">xb.business.job.search</field>
        <field name="model">xb.business.job</field>
        <field name="arch" type="xml">
            <search>
                <field name="whatsapp_number"/>
                <field name="partner_id"/>
                <field name="reply"/>
                <filter name="errors" string="With errors" domain="[('state', '=', 'error')]"/>
                <filter name="drafts" string="Rehearsal" domain="[('state', '=', 'draft')]"/>
                <group>
                    <filter name="by_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="by_day" string="Day" context="{'group_by': 'create_date:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_xb_business_job" model="ir.actions.act_window">
        <field name="name">Agent log</field>
        <field name="res_model">xb.business.job</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Every message the agent handles shows up here</p>
            <p>What it replied, which tools it used and how much it cost.</p>
        </field>
    </record>
</odoo>
