"<div style=\"margin: 0px; padding: 0px;\">\n"
"    <p>Hello <t t-out=\"object.partner_id.name or ''\">customer</t>,</p>\n"
"    <p>As you authorized, we charged <strong t-out=\"format_amount(object.amount, object.currency_id) or ''\">$100.00</strong>\n"
"        to your card <strong t-out=\"object.token_id.display_name or ''\">•••• 4242</strong>.</p>\n"
"    <p t-if=\"object.invoice_ids\">It pays: <t t-out=\"', '.join(object.invoice_ids.mapped('name')) or ''\">INV/2026/0001</t>.</p>\n"
"    <p>Reference: <t t-out=\"object.reference or ''\">INV/2026/0001</t></p>\n"
"    <p>If you have any question, just answer this email.</p>\n"
"    <p><t t-out=\"object.company_id.name or ''\">Company</t></p>\n"
"</div>\n"
"        "
msgstr ""

