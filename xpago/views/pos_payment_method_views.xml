<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="pos_payment_method_view_form" model="ir.ui.view">
        <field name="name">pos.payment.method.form.inherit.xpago</field>
        <field name="model">pos.payment.method</field>
        <field name="inherit_id" ref="point_of_sale.pos_payment_method_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='payment_provider']" position="after">
                <field name="xpago_provider_id" invisible="payment_provider not in ('xpago', 'xpago_spei')"
                       required="payment_provider in ('xpago', 'xpago_spei')"
                       options="{'no_create': True}"/>
                <field name="xpago_terminal_serial" placeholder="N950-123456789" invisible="payment_provider != 'xpago'"
                       required="payment_provider == 'xpago'"/>
                <field name="xpago_choose_account" invisible="payment_provider != 'xpago'"/>
                <field name="xpago_open_terminal_app" invisible="payment_provider != 'xpago'"/>
                <field name="xpago_wake_terminal" invisible="payment_provider != 'xpago'"/>
                <field name="xpago_card_timeout" invisible="payment_provider != 'xpago'"/>
                <div colspan="2" class="text-muted" invisible="payment_provider != 'xpago_spei'">
                    The cashier shows the customer a CLABE made for this sale alone. The customer transfers from any
                    bank (SPEI) and the sale is paid by itself when the money arrives. The CLABE lasts 60 minutes; if
                    it expires, the register makes a new one for the same sale.
                </div>
            </xpath>
        </field>
    </record>
</odoo>
