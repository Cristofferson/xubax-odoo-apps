<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_partner_view_form_domiciliation" model="ir.ui.view">
        <field name="name">res.partner.form.xpago.domiciliation</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button name="action_view_xpago_domiciliations" type="object" class="oe_stat_button" icon="autorenew"
                        groups="account.group_account_invoice" invisible="xpago_domiciliation_count == 0">
                    <field name="xpago_domiciliation_count" widget="statinfo" string="Card on file"/>
                </button>
            </div>
        </field>
    </record>
</odoo>
