<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- The card voucher of the XPago terminals and the CLABE of the XPago transfers, after the footer. The receipt is rendered by Odoo (emailed,
         WhatsApp) and by the point of sale (printed), so only plain expressions. -->
    <template id="pos_order_receipt" inherit_id="point_of_sale.pos_order_receipt">
        <xpath expr="//t[@t-call='point_of_sale.pos_order_receipt_footer']" position="after">
            <t t-foreach="payments" t-as="payment">
                <!-- The card voucher goes on the full receipt only: the basic one is a gift ticket, without prices. -->
                <div t-if="payment.get('xpago_voucher') and not conditions.get('basic_receipt')" class="xpago-voucher w-100 text-start mt-3 pt-2 text-small" style="border-top: 1px dashed black;">
                    <div t-if="payment.get('xpago_refund')" class="w-100 text-center text-bold">REFUND TO CARD</div>
                    <div t-else="" class="w-100 text-center text-bold">CARD SALE</div>
                    <table class="w-100">
                        <tbody>
                            <tr>
                                <td class="text-start"><t t-out="payment['card_brand'] or ''"/> **** <t t-out="payment['card_no'] or ''"/></td>
                                <td class="text-end">
                                    <span t-if="payment.get('xpago_debit')">Debit</span>
                                    <span t-elif="payment.get('xpago_credit')">Credit</span>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                    <div t-if="payment.get('xpago_terms')" class="text-bold"><t t-out="payment['xpago_terms']"/> months without interest</div>
                    <div t-if="payment['payment_method_issuer_bank']">Bank: <t t-out="payment['payment_method_issuer_bank']"/></div>
                    <div t-if="payment['payment_method_authcode']">Authorization: <t t-out="payment['payment_method_authcode']"/></div>
                    <div t-if="payment['payment_ref_no']">Operation: <t t-out="payment['payment_ref_no']"/></div>
                    <div t-if="payment['payment_method_payment_mode']">Entry mode: <t t-out="payment['payment_method_payment_mode']"/></div>
                    <div t-if="config.get('xpago_voucher_merchant')">Merchant number: <t t-out="config['xpago_voucher_merchant']"/></div>
                    <div t-if="extra_data.get('formated_date_order')">Date: <t t-out="extra_data['formated_date_order']"/></div>
                    <table class="w-100">
                        <tbody>
                            <tr class="text-bold">
                                <td class="text-start w-70">Amount</td>
                                <td class="text-end w-30 font-monospace" t-out="payment.get('xpago_amount') or payment['amount']"/>
                            </tr>
                        </tbody>
                    </table>
                    <t t-if="not payment.get('xpago_refund')">
                    <div t-if="payment.get('xpago_debit')" class="mt-2" style="white-space: pre-line;" t-out="config.get('xpago_voucher_debit_text') or ''"/>
                    <div t-else="" class="mt-2" style="white-space: pre-line;" t-out="config.get('xpago_voucher_credit_text') or ''"/>
                    </t>
                    <div t-if="payment.get('xpago_signature')" class="w-100 text-center mt-4">
                        <div style="border-top: 1px solid black; margin: 0 10%;"/>
                        <div>Customer's signature</div>
                    </div>
                </div>
                <!-- A sale paid by XPago transfer: which CLABE and operation it was. -->
                <div t-if="payment.get('xpago_transfer')" class="xpago-transfer-receipt w-100 text-start mt-3 pt-2 text-small" style="border-top: 1px dashed black;">
                    <div t-if="payment.get('xpago_refund')" class="w-100 text-center text-bold">TRANSFER GIVEN BACK (SPEI)</div>
                    <div t-else="" class="w-100 text-center text-bold">PAID BY TRANSFER (SPEI)</div>
                    <div t-if="payment['card_no']">CLABE: **** <t t-out="payment['card_no']"/></div>
                    <div t-if="payment['payment_ref_no']">Operation: <t t-out="payment['payment_ref_no']"/></div>
                    <div t-if="payment['cardholder_name']">Paid by: <t t-out="payment['cardholder_name']"/></div>
                    <table class="w-100">
                        <tbody>
                            <tr class="text-bold">
                                <td class="text-start w-70">Amount</td>
                                <td class="text-end w-30 font-monospace" t-out="payment.get('xpago_amount') or payment['amount']"/>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </t>
        </xpath>
    </template>
</odoo>
