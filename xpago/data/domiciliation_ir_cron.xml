<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ir_cron_domiciliation" model="ir.cron">
        <field name="name">XPago: card on file charges</field>
        <field name="model_id" ref="model_payment_xpago_domiciliation"/>
        <field name="state">code</field>
        <field name="code">model._cron_charge()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="numbercall">-1</field>
        <field name="nextcall" eval="(DateTime.now().replace(hour=14, minute=0, second=0)).strftime('%Y-%m-%d %H:%M:%S')"/>
        <field name="active">True</field>
    </record>
</odoo>
