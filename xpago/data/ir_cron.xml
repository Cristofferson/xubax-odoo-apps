<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ir_cron_sync_pending" model="ir.cron">
        <field name="name">XPago: read back pending online payments</field>
        <field name="model_id" ref="payment.model_payment_transaction"/>
        <field name="state">code</field>
        <field name="code">model._xpago_cron_sync_pending()</field>
        <field name="interval_number">5</field>
        <field name="interval_type">minutes</field>
        <field name="active">True</field>
    </record>
    <record id="ir_cron_sync_bank_accounts" model="ir.cron">
        <field name="name">XPago: read the deposit accounts</field>
        <field name="model_id" ref="payment.model_payment_provider"/>
        <field name="state">code</field>
        <field name="code">model._xpago_cron_sync_bank_accounts()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
        <field name="active">True</field>
    </record>
</odoo>
