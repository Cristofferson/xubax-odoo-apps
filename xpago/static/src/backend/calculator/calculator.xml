<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="xpago.Calculator">
        <div class="o_action o_xpago_calc d-flex flex-column h-100">
            <div class="o_xpago_calc_screen">
                <div class="o_xpago_calc_expr text-truncate" t-out="expression or ' '"/>
                <div class="o_xpago_calc_value text-nowrap" t-att-class="{'text-danger fs-2': state.error}" t-out="display"/>
            </div>
            <div class="o_xpago_calc_keys flex-grow-1">
                <t t-foreach="keys" t-as="row" t-key="row_index">
                    <t t-foreach="row" t-as="key" t-key="key">
                        <button type="button" class="o_xpago_calc_key btn" t-att-class="keyClass(key)"
                                t-att-name="key" t-on-click="() => this.press(key)" t-out="keyLabel(key)"/>
                    </t>
                </t>
            </div>
            <div t-if="state.info.charge" class="o_xpago_calc_charge">
                <t t-if="state.askDevice">
                    <label class="form-label fw-bold mb-1" for="o_xpago_calc_device">Which terminal is this?</label>
                    <select id="o_xpago_calc_device" class="form-select mb-2 o_xpago_calc_device" t-on-change="chooseThisTerminal">
                        <option value="">Choose it once (serial number on the back)</option>
                        <option t-foreach="state.info.terminals" t-as="t" t-key="t.id" t-att-value="t.id" t-out="t.name"/>
                    </select>
                </t>
                <div t-elif="state.onDevice" class="text-muted small text-center mb-2 o_xpago_calc_here">
                    <i class="fa fa-mobile me-1"/>Charges on this terminal
                </div>
                <select t-elif="state.info.terminals.length > 1" class="form-select mb-2 o_xpago_calc_terminals" t-on-change="chooseTerminal">
                    <option t-foreach="state.info.terminals" t-as="t" t-key="t.id" t-att-value="t.id"
                            t-att-selected="t.id === state.terminalId" t-out="t.name"/>
                </select>
                <button type="button" class="btn btn-success btn-lg w-100 o_xpago_calc_charge_btn"
                        t-att-disabled="!amount or state.askDevice" t-on-click="charge">
                    <i class="fa fa-credit-card me-2"/>
                    <t t-if="amount">Collect <t t-out="money(amount)"/></t>
                    <t t-else="">Collect</t>
                </button>
            </div>
            <div t-if="state.charge" class="o_xpago_calc_overlay d-flex align-items-center justify-content-center">
                <div class="o_xpago_calc_card text-center">
                    <div class="fs-1 fw-bold mb-2" t-out="money(state.charge.amount)"/>
                    <t t-if="state.charge.phase === 'waiting'">
                        <div class="mb-1"><i class="fa fa-circle-o-notch fa-spin me-2"/>Waiting for the card</div>
                        <div class="text-muted small mb-3">on <t t-out="state.charge.terminal"/></div>
                        <button type="button" class="btn btn-outline-danger btn-lg w-100 o_xpago_calc_cancel"
                                t-att-disabled="!state.charge.id or state.charge.cancelling" t-on-click="cancelCharge">
                            Cancel the charge
                        </button>
                    </t>
                    <t t-elif="state.charge.phase === 'paid'">
                        <div class="text-success fs-3 mb-1"><i class="fa fa-check-circle me-2"/>Paid</div>
                        <div class="text-muted mb-1" t-if="state.charge.card" t-out="state.charge.card"/>
                        <div class="text-muted small mb-3" t-if="state.charge.auth">Authorization <t t-out="state.charge.auth"/></div>
                        <button type="button" class="btn btn-primary btn-lg w-100 o_xpago_calc_new" t-on-click="closeCharge">New calculation</button>
                    </t>
                    <t t-else="">
                        <div class="text-danger fs-4 mb-2"><i class="fa fa-times-circle me-2"/>Not charged</div>
                        <div class="mb-3" t-out="state.charge.message"/>
                        <button type="button" class="btn btn-secondary btn-lg w-100 o_xpago_calc_back" t-on-click="closeCharge">Back</button>
                    </t>
                </div>
            </div>
        </div>
    </t>
</templates>
