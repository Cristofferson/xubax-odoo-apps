<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <!-- The confirmation popup of Odoo 17, keeping the line breaks of the parts. -->
    <t t-name="xpago.XpagoSplitPopup" t-inherit="point_of_sale.ConfirmPopup" t-inherit-mode="primary">
        <xpath expr="//main[hasclass('modal-body')]" position="attributes">
            <attribute name="style">white-space: pre-line</attribute>
        </xpath>
    </t>

</templates>
