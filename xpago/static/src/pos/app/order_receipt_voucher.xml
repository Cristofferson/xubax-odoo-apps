<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="xpago.OrderReceipt" t-inherit="point_of_sale.OrderReceipt" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('after-footer')]" position="inside">
            <!-- The card voucher goes on the full receipt only: the basic one is a gift ticket, without prices. -->
            <t t-foreach="props.basic_receipt ? [] : xpagoVoucherLines" t-as="line" t-key="line.uuid">
                <div class="xpago-voucher text-start mt-3 pt-2" style="border-top: 1px dashed currentColor; font-size: 85%;">
                    <div t-if="line.amount &lt; 0" class="text-center fw-bolder">REFUND TO CARD</div>
                    <div t-else="" class="text-center fw-bolder">CARD SALE</div>
                    <div class="d-flex justify-content-between">
                        <span><t t-esc="line.card_brand"/> **** <t t-esc="line.card_no"/></span>
                        <span t-esc="xpagoFunding(line)"/>
                    </div>
                    <div t-if="line.xpago_terms > 1" class="fw-bolder"><t t-esc="line.xpago_terms"/> months without interest</div>
                    <div t-if="line.payment_method_issuer_bank">Bank: <t t-esc="line.payment_method_issuer_bank"/></div>
                    <div t-if="line.payment_method_authcode">Authorization: <t t-esc="line.payment_method_authcode"/></div>
                    <div t-if="line.payment_ref_no">Operation: <t t-esc="line.payment_ref_no"/></div>
                    <div t-if="line.payment_method_payment_mode">Entry mode: <t t-esc="line.payment_method_payment_mode"/></div>
                    <div t-if="order.config.xpago_voucher_merchant">Merchant number: <t t-esc="order.config.xpago_voucher_merchant"/></div>
                    <div t-if="order.date_order">Date: <t t-esc="order.formatDateOrTime('date_order')"/></div>
                    <div class="d-flex justify-content-between fw-bolder">
                        <span>Amount</span>
                        <span t-out="formatCurrency(Math.abs(line.getAmount()))" class="font-monospace"/>
                    </div>
                    <div t-if="line.amount &gt; 0" class="mt-2" style="white-space: pre-line; font-size: 90%;" t-esc="xpagoLegend(line)"/>
                    <div t-if="xpagoNeedsSignature(line)" class="text-center mt-4">
                        <div style="border-top: 1px solid currentColor; margin: 0 10%;"/>
                        <div>Customer's signature</div>
                    </div>
                </div>
            </t>
        </xpath>
    </t>

    <!-- The two print buttons say what they print: the full ticket, and the gift ticket (Odoo's «basic receipt»,
         without prices). -->
    <t t-name="xpago.ReceiptScreenGiftTicket" t-inherit="point_of_sale.ReceiptScreen" t-inherit-mode="extension">
        <xpath expr="//button[@t-on-click='() => doFullPrint.call()']" position="replace">
            <button class="button print btn btn-lg btn-secondary w-100 py-3" t-on-click="() => doFullPrint.call()">
                <i t-attf-class="fa {{doFullPrint.status === 'loading' ? 'fa-fw fa-spin fa-circle-o-notch' : 'fa-print'}} me-1"/>Print Full Ticket
            </button>
        </xpath>
        <xpath expr="//button[@t-on-click='() => doBasicPrint.call()']" position="replace">
            <button t-if="pos.config.basic_receipt" class="button print btn btn-lg btn-secondary w-100 py-3" t-on-click="() => doBasicPrint.call()">
                <i t-attf-class="fa {{doBasicPrint.status === 'loading' ? 'fa-fw fa-spin fa-circle-o-notch' : 'fa-gift'}} me-1"/>Print Gift Ticket
            </button>
        </xpath>
    </t>
</templates>
