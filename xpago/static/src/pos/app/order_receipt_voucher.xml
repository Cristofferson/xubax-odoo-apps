<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="xpago.OrderReceipt" t-inherit="point_of_sale.OrderReceipt" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('after-footer')]" position="inside">
            <!-- The card voucher goes on the full receipt only: the basic one is a gift ticket, without prices. -->
            <t t-foreach="props.basic_receipt ? [] : (props.data.xpago_vouchers or [])" t-as="voucher" t-key="voucher.uuid">
                <div class="xpago-voucher text-start mt-3 pt-2" style="border-top: 1px dashed currentColor; font-size: 85%;">
                    <div class="text-center fw-bolder">CARD SALE</div>
                    <div class="d-flex justify-content-between">
                        <span><t t-esc="voucher.card_brand"/> **** <t t-esc="voucher.card_no"/></span>
                        <span t-esc="voucher.funding"/>
                    </div>
                    <div t-if="voucher.terms > 1" class="fw-bolder"><t t-esc="voucher.terms"/> months without interest</div>
                    <div t-if="voucher.bank">Bank: <t t-esc="voucher.bank"/></div>
                    <div t-if="voucher.authorization">Authorization: <t t-esc="voucher.authorization"/></div>
                    <div t-if="voucher.operation">Operation: <t t-esc="voucher.operation"/></div>
                    <div t-if="voucher.entry_mode">Entry mode: <t t-esc="voucher.entry_mode"/></div>
                    <div t-if="voucher.merchant">Merchant number: <t t-esc="voucher.merchant"/></div>
                    <div t-if="props.data.date">Date: <t t-esc="props.data.date"/></div>
                    <div class="d-flex justify-content-between fw-bolder">
                        <span>Amount</span>
                        <span t-esc="props.formatCurrency(voucher.amount)" class="font-monospace"/>
                    </div>
                    <div class="mt-2" style="white-space: pre-line; font-size: 90%;" t-esc="voucher.legend"/>
                    <div t-if="voucher.signature" class="text-center mt-4">
                        <div style="border-top: 1px solid currentColor; margin: 0 10%;"/>
                        <div>Customer's signature</div>
                    </div>
                </div>
            </t>
        </xpath>
    </t>

    <!-- The two print buttons say what they print: the full ticket, and the gift ticket (Odoo's «basic receipt»,
         without prices). -->
    <t t-name="xpago.ReceiptScreenGiftTicket" t-inherit="point_of_sale.ReceiptScreen" t-inherit-mode="extension">
        <xpath expr="//button[@t-on-click='() => doFullPrint.call()']" position="replace">
            <button class="button print btn btn-lg btn-secondary w-100 py-3" t-on-click="() => doFullPrint.call()">
                <i t-attf-class="fa {{doFullPrint.status === 'loading' ? 'fa-fw fa-spin fa-circle-o-notch' : 'fa-print'}} me-1"/>Print Full Ticket
            </button>
        </xpath>
        <xpath expr="//button[@t-on-click='() => doBasicPrint.call()']" position="replace">
            <button t-if="pos.config.basic_receipt" class="button print btn btn-lg btn-secondary w-100 py-3" t-on-click="() => doBasicPrint.call()">
                <i t-attf-class="fa {{doBasicPrint.status === 'loading' ? 'fa-fw fa-spin fa-circle-o-notch' : 'fa-gift'}} me-1"/>Print Gift Ticket
            </button>
        </xpath>
    </t>
</templates>
