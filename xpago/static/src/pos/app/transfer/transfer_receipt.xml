<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="xpago.OrderReceiptTransfer" t-inherit="point_of_sale.OrderReceipt" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('after-footer')]" position="inside">
            <t t-foreach="xpagoTransferLines" t-as="line" t-key="line.uuid">
                <div class="xpago-transfer-receipt text-start mt-3 pt-2" style="border-top: 1px dashed currentColor; font-size: 85%;">
                    <div t-if="line.amount &lt; 0" class="text-center fw-bolder">TRANSFER GIVEN BACK (SPEI)</div>
                    <div t-else="" class="text-center fw-bolder">PAID BY TRANSFER (SPEI)</div>
                    <div t-if="line.card_no">CLABE: **** <t t-esc="line.card_no"/></div>
                    <div t-if="line.payment_ref_no">Operation: <t t-esc="line.payment_ref_no"/></div>
                    <div t-if="line.cardholder_name">Paid by: <t t-esc="line.cardholder_name"/></div>
                    <div class="d-flex justify-content-between fw-bolder">
                        <span>Amount</span>
                        <span t-out="formatCurrency(Math.abs(line.getAmount()))" class="font-monospace"/>
                    </div>
                </div>
            </t>
        </xpath>
    </t>
</templates>
