<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="xpago.OrderReceiptTransfer" t-inherit="point_of_sale.OrderReceipt" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('after-footer')]" position="inside">
            <t t-foreach="props.data.paymentlines" t-as="line" t-key="line_index">
                <t t-set="transfer" t-value="line.xpago_transfer"/>
                <div t-if="transfer" class="xpago-transfer-receipt text-start mt-3 pt-2" style="border-top: 1px dashed currentColor; font-size: 85%;">
                    <div t-if="transfer.refund" class="text-center fw-bolder">TRANSFER GIVEN BACK (SPEI)</div>
                    <div t-else="" class="text-center fw-bolder">PAID BY TRANSFER (SPEI)</div>
                    <div t-if="transfer.clabe_last4">CLABE: **** <t t-esc="transfer.clabe_last4"/></div>
                    <div t-if="transfer.operation">Operation: <t t-esc="transfer.operation"/></div>
                    <div t-if="transfer.holder">Paid by: <t t-esc="transfer.holder"/></div>
                    <div class="d-flex justify-content-between fw-bolder">
                        <span>Amount</span>
                        <span t-esc="props.formatCurrency(transfer.amount || Math.abs(line.amount))" class="font-monospace"/>
                    </div>
                </div>
            </t>
        </xpath>
    </t>
</templates>
