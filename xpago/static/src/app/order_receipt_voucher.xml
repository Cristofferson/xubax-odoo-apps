<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="xpago.OrderReceipt" t-inherit="point_of_sale.OrderReceipt" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('after-footer')]" position="inside">
            <t t-foreach="xpagoVoucherLines" t-as="line" t-key="line.uuid">
                <div class="xpago-voucher text-start mt-3 pt-2" style="border-top: 1px dashed currentColor; font-size: 85%;">
                    <div class="text-center fw-bolder">CARD SALE</div>
                    <div class="d-flex justify-content-between">
                        <span><t t-esc="line.card_brand"/> **** <t t-esc="line.card_no"/></span>
                        <span t-esc="xpagoFunding(line)"/>
                    </div>
                    <div t-if="line.payment_method_issuer_bank">Bank: <t t-esc="line.payment_method_issuer_bank"/></div>
                    <div t-if="line.payment_method_authcode">Authorization: <t t-esc="line.payment_method_authcode"/></div>
                    <div t-if="line.payment_ref_no">Reference: <t t-esc="line.payment_ref_no"/></div>
                    <div t-if="line.transaction_id" class="text-break">Operation: <t t-esc="line.transaction_id"/></div>
                    <div t-if="line.payment_method_payment_mode">Entry mode: <t t-esc="line.payment_method_payment_mode"/></div>
                    <div t-if="order.config.xpago_voucher_merchant">Merchant number: <t t-esc="order.config.xpago_voucher_merchant"/></div>
                    <div t-if="order.date_order">Date: <t t-esc="order.formatDateOrTime('date_order')"/></div>
                    <div class="d-flex justify-content-between fw-bolder">
                        <span>Amount</span>
                        <span t-out="formatCurrency(line.getAmount())" class="font-monospace"/>
                    </div>
                    <div class="mt-2" style="white-space: pre-line; font-size: 90%;" t-esc="xpagoLegend(line)"/>
                    <div t-if="order.config.xpago_voucher_signature" class="text-center mt-4">
                        <div style="border-top: 1px solid currentColor; margin: 0 10%;"/>
                        <div>Customer's signature</div>
                    </div>
                </div>
            </t>
        </xpath>
    </t>
</templates>
