<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="xpago.SelfOrderPaymentPage" t-inherit="pos_self_order.PaymentPage" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('o_kiosk-card')]//i" position="attributes">
            <attribute name="class"/>
            <attribute name="t-att-class">payment_method.use_payment_terminal === 'xpago_spei' ? 'fa fa-university' : 'fa fa-credit-card'</attribute>
        </xpath>
        <!-- Hidden by class, not t-if: pos_online_payment_self_order sets this block's t-if. -->
        <xpath expr="//div[hasclass('payment-state-container')]" position="attributes">
            <attribute name="t-att-class">{'d-none': xpagoIsTransfer}</attribute>
        </xpath>
        <xpath expr="//div[hasclass('payment-state-container')]" position="after">
            <div t-if="xpagoIsTransfer and !state.selection and xpagoTransfer.step === 'form'"
                 class="xpago-kiosk-transfer-form d-flex flex-column gap-3 mx-auto p-3" style="max-width: 36rem;">
                <h1 class="text-center mb-0">Pay by transfer</h1>
                <div class="text-center text-muted fs-4">
                    <t t-out="xpagoMoney(xpagoTransferAmount)"/> · We make a CLABE for this purchase only.
                </div>
                <label class="fs-4">Name
                    <input type="text" class="form-control form-control-lg xpago-kiosk-transfer-name" autocomplete="off"
                           t-model="xpagoTransfer.name"/>
                </label>
                <label class="fs-4">Mobile phone
                    <input type="tel" inputmode="tel" class="form-control form-control-lg xpago-kiosk-transfer-phone"
                           autocomplete="off" maxlength="15" t-model="xpagoTransfer.phone"/>
                </label>
                <label class="fs-4">Email
                    <input type="email" inputmode="email" class="form-control form-control-lg xpago-kiosk-transfer-email"
                           autocomplete="off" t-model="xpagoTransfer.email"/>
                </label>
                <div class="small text-muted">Your bank asks for them to make the CLABE. They are only used for this payment.</div>
                <div class="d-flex gap-3">
                    <button class="btn btn-secondary btn-lg flex-fill" t-on-click="xpagoTransferBack">Back</button>
                    <button class="btn btn-primary btn-lg flex-fill xpago-kiosk-transfer-submit" t-att-disabled="xpagoTransfer.busy"
                            t-on-click="xpagoTransferSubmit">
                        <i t-if="xpagoTransfer.busy" class="fa fa-circle-o-notch fa-spin me-2"/>See the CLABE
                    </button>
                </div>
            </div>
            <div t-if="xpagoIsTransfer and !state.selection and xpagoTransfer.step === 'clabe' and xpagoTransfer.view"
                 class="xpago-kiosk-transfer text-center mx-auto p-3" style="max-width: 44rem;">
                <t t-set="view" t-value="xpagoTransfer.view"/>
                <t t-if="view.state === 'paid'">
                    <h1><i class="fa fa-check-circle text-success me-2"/>Transfer received</h1>
                </t>
                <t t-else="">
                    <div class="fs-4 text-muted">Transfer exactly</div>
                    <div class="display-5 fw-bold mb-2" t-out="xpagoMoney(view.amount_received &gt; 0 and view.amount_due &gt; 0 ? view.amount_due : view.amount)"/>
                    <div class="fs-4 text-muted">to the CLABE</div>
                    <div class="xpago-clabe font-monospace fw-bolder text-nowrap my-1" style="font-size: min(3rem, 7vw); letter-spacing: .04em;"
                         t-out="xpagoClabeText"/>
                    <div class="d-flex flex-wrap gap-4 justify-content-center align-items-center mt-3">
                        <table class="table table-sm text-start fs-5 mb-0" style="max-width: 24rem;">
                            <tbody>
                                <tr><td class="text-muted">Bank</td><td class="fw-bold" t-out="view.bank"/></tr>
                                <tr><td class="text-muted">Beneficiary</td>
                                    <td><span class="fw-bold" t-out="view.beneficiary"/> <span class="text-muted">· for</span> <t t-out="view.business"/></td></tr>
                                <tr t-if="view.concept"><td class="text-muted">Concept (optional)</td><td t-out="view.concept"/></tr>
                                <tr t-if="xpagoMinutesLeft !== null"><td class="text-muted">Time left</td><td><t t-out="xpagoMinutesLeft"/> min</td></tr>
                            </tbody>
                        </table>
                        <div t-if="xpagoQrUrl" class="d-flex flex-column align-items-center">
                            <img t-att-src="xpagoQrUrl" alt="QR" width="200" height="200"/>
                            <div class="fs-5 text-muted" style="max-width: 14rem;">Scan it to copy the CLABE on your phone</div>
                        </div>
                    </div>
                    <div class="small text-muted mt-3">
                        Your bank shows the beneficiary when it checks the CLABE: it is XPago's bank, on behalf of this business.
                        Your order is confirmed by itself as soon as the money arrives.
                    </div>
                    <div class="mt-3 fs-4 text-primary"><i class="fa fa-circle-o-notch fa-spin me-2"/>Waiting for your transfer…</div>
                    <button class="btn btn-secondary btn-lg mt-3 xpago-kiosk-transfer-cancel" t-on-click="xpagoTransferCancel">Cancel</button>
                </t>
            </div>
        </xpath>
    </t>
</templates>
