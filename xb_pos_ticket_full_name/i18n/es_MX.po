#. module: xb_pos_ticket_full_name
#: model:ir.module.module,shortdesc:base.module_xb_pos_ticket_full_name
msgid "POS Receipt – Full Product Name (no truncation)"
msgstr "Ticket de PdV – Nombre completo del producto (sin recortar)"

#. module: xb_pos_ticket_full_name
#: model:ir.module.module,summary:base.module_xb_pos_ticket_full_name
msgid ""
"Print the complete product name on POS receipts. Long names wrap onto "
"several lines instead of being cut off with an ellipsis."
msgstr ""
"Imprime el nombre completo del producto en los tickets del PdV. Los nombres "
"largos se ajustan en varias líneas en vez de recortarse con puntos "
"suspensivos."
