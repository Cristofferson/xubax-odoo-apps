<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">

    <t t-name="xb_special_dates.CaptureSpecialDatePopup">
        <Dialog title.translate="Special Date" size="'md'">
            <div class="xb-capture-popup">

                <div class="xb-capture-header">
                    <div class="xb-capture-emoji">
                        <t t-esc="selectedChoice.icon"/>
                    </div>
                    <h3 class="xb-capture-title">
                        Register a special date?
                    </h3>
                </div>

                <p class="xb-capture-text">
                    Register a <strong t-esc="selectedChoice.name"/>
                    for <strong t-esc="props.partnerName"/>?
                </p>

                <div t-if="multiple" class="xb-capture-choices-wrap">
                    <small class="xb-capture-hint">
                        This product matches several events. Pick the right one.
                    </small>
                    <div class="xb-capture-choices">
                        <button
                            t-foreach="props.choices"
                            t-as="choice"
                            t-key="choice.wishTypeId"
                            type="button"
                            class="xb-capture-choice"
                            t-att-class="{ 'xb-capture-choice-selected': choice.wishTypeId === state.wishTypeId }"
                            t-on-click="() => this.onSelectChoice(choice.wishTypeId)">
                            <span class="xb-capture-choice-icon" t-esc="choice.icon"/>
                            <span class="xb-capture-choice-name" t-esc="choice.name"/>
                        </button>
                    </div>
                </div>

                <div class="xb-capture-field">
                    <label class="xb-capture-label">Event date</label>
                    <input
                        type="date"
                        class="form-control xb-capture-date-input"
                        t-att-value="state.date"
                        t-on-change="onDateChange"
                    />
                    <small class="xb-capture-hint">
                        <t t-esc="formattedDate"/>
                    </small>
                </div>

            </div>
            <t t-set-slot="footer">
                <div class="xb-capture-actions">
                    <button class="btn btn-primary"
                            t-att-disabled="state.busy"
                            t-on-click="onClickConfirm">
                        Yes, register
                    </button>
                    <button class="btn btn-secondary"
                            t-att-disabled="state.busy"
                            t-on-click="onClickLater">
                        Later
                    </button>
                    <button class="btn btn-link text-muted"
                            t-att-disabled="state.busy"
                            t-on-click="onClickDismiss">
                        Not applicable
                    </button>
                </div>
            </t>
        </Dialog>
    </t>

</templates>
