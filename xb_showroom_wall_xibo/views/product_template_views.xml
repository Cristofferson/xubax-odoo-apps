<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- With Xibo installed the product already has a signage tab: the wall
         box lives there, next to the other screen settings, instead of among
         the product's sale options. Applied last, after both views it moves
         things between. -->
    <record id="product_template_form_showroom_xibo" model="ir.ui.view">
        <field name="name">product.template.form.showroom.xibo</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <xpath expr="//span[@name='showroom_option']" position="replace"/>
            <xpath expr="//page[@name='xibo_signage']/group" position="inside">
                <field name="xb_showroom_enabled" groups="sales_team.group_sale_manager"/>
            </xpath>
        </field>
    </record>

</odoo>
