#. module: xb_showroom_wall_xibo
#. odoo-python
#: code:addons/xb_showroom_wall_xibo/models/showroom_screen.py:0
msgid "%(screen)s is back on «%(previous)s»."
msgstr "%(screen)s regresó a «%(previous)s»."

#. module: xb_showroom_wall_xibo
#. odoo-python
#: code:addons/xb_showroom_wall_xibo/models/showroom_screen.py:0
msgid "%s keeps its default layout; the wall takes over when a piece is sent."
msgstr ""
"%s conserva su disposición por defecto; el muro entra cuando se manda una "
"pieza."

#. module: xb_showroom_wall_xibo
#: model_terms:ir.ui.view,arch_db:xb_showroom_wall_xibo.view_showroom_screen_form_xibo
msgid ""
"<b>Always on screen</b>: the wall becomes the screen's default\n"
"                            layout. When nobody is driving it, it shows its own shop window;\n"
"                            a purchase thank-you still appears on top and then gives the\n"
"                            screen back. Instant."
msgstr ""
"<b>Siempre en pantalla</b>: el muro se vuelve la disposición por defecto de "
"la pantalla. Cuando nadie lo usa, muestra su propia vitrina; el "
"agradecimiento por compra aparece encima y luego devuelve la pantalla. "
"Inmediato."

#. module: xb_showroom_wall_xibo
#: model_terms:ir.ui.view,arch_db:xb_showroom_wall_xibo.view_showroom_screen_form_xibo
msgid ""
"<b>Only while pieces are shown</b>: the screen keeps its own\n"
"                            default layout and the wall takes over when a sales person sends a\n"
"                            piece, as the thank-you does. It goes back when the wall is cleared\n"
"                            or left idle. It relies on the player's live channel: a player that\n"
"                            does not receive it picks the change up on its next check-in."
msgstr ""
"<b>Solo mientras se muestran piezas</b>: la pantalla conserva su propia "
"disposición por defecto y el muro entra cuando un vendedor manda una pieza, "
"igual que el agradecimiento. Regresa al vaciar el muro o al quedar sin uso. "
"Depende del canal en vivo del reproductor: si no le llega, toma el cambio en"
" su siguiente revisión."

#. module: xb_showroom_wall_xibo
#: model:ir.model.fields.selection,name:xb_showroom_wall_xibo.selection__xb_showroom_screen__xibo_mode__default
msgid "Always on screen (default layout)"
msgstr "Siempre en pantalla (disposición por defecto)"

#. module: xb_showroom_wall_xibo
#: model:ir.model.fields,help:xb_showroom_wall_xibo.field_xb_showroom_screen__xibo_mode
msgid ""
"Always on screen: the wall becomes the screen's default layout and shows its own shop window when idle. Instant.\n"
"Only while pieces are shown: the screen keeps its own default layout; the wall takes over when a piece is sent and hands the screen back when cleared or idle. Relies on the player's live channel, as the purchase thank-you does."
msgstr ""
"Siempre en pantalla: el muro se vuelve la disposición por defecto de la pantalla y, sin uso, muestra su propia vitrina. Inmediato.\n"
"Solo mientras se muestran piezas: la pantalla conserva su propia disposición por defecto; el muro entra cuando se manda una pieza y devuelve la pantalla al vaciarse o quedar sin uso. Depende del canal en vivo del reproductor, igual que el agradecimiento por compra."

