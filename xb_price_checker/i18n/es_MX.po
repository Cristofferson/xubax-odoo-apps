msgstr ""
"Las pantallas que tienen la liga actual dejarán de funcionar. ¿Continuar?"

#. module: xb_price_checker
#. odoo-python
#: code:addons/xb_price_checker/manual.py:0
msgid "The stock line does not show"
msgstr "No sale la línea de existencias"

#. module: xb_price_checker
#. odoo-python
#: code:addons/xb_price_checker/manual.py:0
