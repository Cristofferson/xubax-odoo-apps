#: code:addons/xb_price_checker/manual.py:0
msgid ""
"Tap the screen once. Check that the scanner types into a notepad and presses"
" Enter at the end."
msgstr ""
"Toca una vez la pantalla. Revisa que el lector escriba en un bloc de notas y"
" dé Enter al final."

#. module: xb_price_checker
#: model:ir.model.fields,help:xb_price_checker.field_pos_config__price_checker_show_stock
#: model:ir.model.fields,help:xb_price_checker.field_res_config_settings__pos_price_checker_show_stock
msgid ""
"Tell the customer whether this store has the product (without the number of "
"pieces)."
msgstr ""
"Decirle al cliente si esta tienda tiene el producto (sin el número de "
"piezas)."

#. module: xb_price_checker
#. odoo-python
#: code:addons/xb_price_checker/manual.py:0
msgid "Terminal: \"Falta instalar «Verificador de precios» en tu Odoo\""
msgstr "Terminal: «Falta instalar “Verificador de precios” en tu Odoo»"

#. module: xb_price_checker
#. odoo-python
