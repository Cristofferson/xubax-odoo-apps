<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_price_checker" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.xb_price_checker</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@invisible='not pos_config_id']" position="inside">
                <block title="Price checker" id="xb_price_checker_block">
                    <setting id="xb_price_checker_link" string="Price checker"
                             help="A screen where customers scan a product and see its price, with the prices, taxes and stock of this Point of Sale. Open the link on a tablet with a barcode scanner and leave it there: no user is needed.">
                        <div class="mt8">
                            <button name="action_price_checker_open" type="object" string="Open the price checker" class="btn-primary" icon="fa-external-link"/>
                            <button name="action_price_checker_install" type="object" string="Install as an app" class="btn-secondary ms-2" icon="fa-download"/><!-- scoped_app: Odoo 18+ -->
                            <button name="action_price_checker_new_link" type="object" string="New link" class="btn-link"
                                    confirm="The screens that have the current link stop working. Continue?"/>
                        </div>
                        <field name="pos_price_checker_url" widget="CopyClipboardChar" invisible="not pos_price_checker_url" class="mt8"/>
                    </setting>
                    <setting id="xb_price_checker_stock" string="Show stock" help="Available or out of stock in this store, without the number of pieces.">
                        <field name="pos_price_checker_show_stock"/>
                    </setting>
                    <setting id="xb_price_checker_months" string="Show months without interest" help="From the payment rules, when the XPago app is installed.">
                        <field name="pos_price_checker_show_months"/>
                    </setting>
                    <setting id="xb_price_checker_idle" string="Back to the start" help="Seconds a product stays on screen.">
                        <field name="pos_price_checker_idle"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
