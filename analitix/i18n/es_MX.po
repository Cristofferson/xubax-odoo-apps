#. module: analitix
#. odoo-python
#: code:addons/analitix/models/analitix_device.py:0
msgid "%(key)s\\n\\nThis is the only time it is shown. Odoo stores only a hash of it; if it is lost, rotate again."
msgstr "%(key)s\\n\\nEsta es la única vez que se muestra. Odoo solo guarda un hash; si se pierde, hay que rotarla otra vez."

#. module: analitix
#. odoo-python
#: code:addons/analitix/wizards/store_setup.py:0
msgid "%s counter"
msgstr "Contador de %s"

#. module: analitix
#: model:ir.model.constraint,message:analitix.constraint_analitix_store_offline_after_degraded
msgid "'Offline After' must be at least as long as 'Degraded After'."
msgstr "'Fuera de línea tras' debe ser al menos tan largo como 'Degradado tras'."

#. module: analitix
#: model_terms:ir.ui.view,arch_db:analitix.view_store_setup_form
msgid "<b>Copy these keys now.</b> Odoo keeps only a hash of them, so\\n                        this screen is the one and only time they can be read. Paste\\n                        each into its device's agent configuration before you leave the\\n                        site. If one is lost, rotate it from the device form."
msgstr "<b>Copia estas llaves ahora.</b> Odoo solo guarda un hash de ellas, así que esta pantalla es la única vez que se pueden leer. Pega cada una en la configuración del agente de su dispositivo antes de irte del sitio. Si se pierde alguna, rótala desde la ficha del dispositivo."

#. module: analitix
#: model_terms:ir.ui.view,arch_db:analitix.view_users_form_analitix
msgid "<b>Empty means every store</b> of the companies this user\\n                            already belongs to. That is the right setting for a\\n                            customer who runs one store, and it needs no configuration."
msgstr "<b>Vacío significa todas las tiendas</b> de las compañías a las que este usuario ya pertenece. Es lo correcto para un cliente con una sola tienda, y no requiere configurar nada."

#. module: analitix
#: model_terms:ir.ui.view,arch_db:analitix.view_store_kanban
msgid "<span class=\\\"text-muted d-block small\\\">Inside now</span>"
msgstr "<span class=\\\"text-muted d-block small\\\">Dentro ahora</span>"

#. module: analitix
#: model_terms:ir.ui.view,arch_db:analitix.view_store_kanban
msgid "<span class=\\\"text-muted d-block small\\\">Visitors today</span>"
msgstr "<span class=\\\"text-muted d-block small\\\">Visitantes hoy</span>"

#. module: analitix
#: model:ir.model.fields,help:analitix.field_analitix_device__critical
msgid "A critical device is one whose silence makes this store's numbers wrong: any door counter, or the checkout camera. When it goes offline the technical contacts are alerted. Clear the flag for a spare or experimental unit so it does not page anyone at 3 a.m."
msgstr "Un dispositivo crítico es aquel cuyo silencio deja mal los números de esta tienda: cualquier contador de puerta o la cámara de caja. Cuando se cae, se avisa a los contactos técnicos. Quita la marca en un equipo de repuesto o de pruebas para que no despierte a nadie a las 3 de la mañana."

#. module: analitix
#: model:ir.model.constraint,message:analitix.constraint_analitix_event_count_positive
msgid "A crossing must involve at least one person."
msgstr "Un cruce debe involucrar al menos a una persona."

#. module: analitix
#: model:ir.model.fields,help:analitix.field_analitix_store__offline_threshold_min
msgid "A device that has not sent a heartbeat for this long is marked offline. Raise it on stores with a flaky connection so a 90-second outage does not page the technician every night."
msgstr "Un dispositivo que no manda latido durante este tiempo se marca fuera de línea. Súbelo en tiendas con conexión inestable para que un corte de 90 segundos no despierte al técnico cada noche."

#. module: analitix
#: model:ir.model.fields,help:analitix.field_analitix_device__api_key_revoked
msgid "A revoked device is refused by the ingest endpoint immediately, without waiting for anyone to reach the hardware."
msgstr "Un dispositivo revocado es rechazado por el endpoint de ingesta de inmediato, sin esperar a que alguien llegue al equipo."

#. module: analitix
#: model_terms:ir.ui.view,arch_db:analitix.view_staff_signature_form
msgid "A signature is a list of numbers produced from a face by\\n                        the enrolment tool. No photograph is stored here or\\n                        anywhere else in Analitix, and no image can be rebuilt\\n                        from it. It is encrypted in the database and its only\\n                        use is to keep this employee out of the visitor count."
msgstr "Una firma es una lista de números que la herramienta de registro produce a partir de un rostro. Aquí no se guarda ninguna fotografía, ni en ninguna otra parte de Analitix, y de la firma no se puede reconstruir ninguna imagen. Está cifrada en la base de datos y su único uso es mantener a este empleado fuera del conteo de visitantes."

