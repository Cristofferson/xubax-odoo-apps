#. module: analitix
#: model_terms:ir.actions.act_window,help:analitix.action_zone
msgid "\\\"Twelve minutes inside\\\" tells an owner nothing. \\\"Eleven of those\\n                twelve in front of the engagement rings, and nobody spoke to\\n                them\\\" tells them exactly where the money went."
msgstr "\"Doce minutos adentro\" no le dice nada al dueño. \"Once de esos doce frente a los anillos de compromiso, y nadie le habló\" le dice exactamente por dónde se fue el dinero."

#. module: analitix
#. odoo-python
#: code:addons/analitix/models/analitix_anomaly.py:0
msgid "%(detail)s\\n\\nWorth going over. This is a behaviour pattern, not an accusation — most of the time the person simply wants help."
msgstr "%(detail)s\\n\\nVale la pena echar un ojo. Esto es un patrón de conducta, no una acusación: la mayoría de las veces la persona solo quiere que la atiendan."

#. module: analitix
#. odoo-python
#: code:addons/analitix/models/analitix_device.py:0
msgid "%(key)s\\n\\nThis is the only time it is shown. Odoo stores only a hash of it; if it is lost, rotate again."
msgstr "%(key)s\\n\\nEsta es la única vez que se muestra. Odoo solo guarda un hash; si se pierde, hay que rotarla otra vez."

#. module: analitix
#. odoo-python
#: code:addons/analitix/models/analitix_anomaly.py:0
msgid "%(mins)s minutes at %(zone)s, unattended."
msgstr "%(mins)s minutos en %(zone)s, sin atender."

#. module: analitix
#. odoo-python
#: code:addons/analitix/models/analitix_value_report.py:0
msgid "%(missed)s alerts went unanswered. Each one was somebody waiting."
msgstr "%(missed)s avisos quedaron sin atender. Cada uno era alguien esperando."

#. module: analitix
#. odoo-python
#: code:addons/analitix/models/analitix_anomaly.py:0
msgid "%(n)s re-entries during one visit."
msgstr "%(n)s reingresos durante una misma visita."

#. module: analitix
#. odoo-python
#: code:addons/analitix/models/analitix_face_signature.py:0
msgid "%(name)s just came in"
msgstr "%(name)s acaba de entrar"

#. module: analitix
#. odoo-python
#: code:addons/analitix/models/analitix_store.py:0
msgid "%(names)s cannot open watch-list entries, so telling them about a match would be a warning with no explanation attached. Give them the Analitix security role first, or leave them off this list."
msgstr "%(names)s no puede abrir entradas de la lista de vigilancia, así que avisarles de una coincidencia sería una advertencia sin explicación. Dales primero el rol de seguridad de Analitix, o déjalos fuera de esta lista."

#. module: analitix
#. odoo-python
#: code:addons/analitix/models/analitix_anomaly.py:0
msgid "%(size)s people arrived together and are now in %(zones)s different zones."
msgstr "%(size)s personas llegaron juntas y ahora están en %(zones)s zonas distintas."

#. module: analitix
#. odoo-python
#: code:addons/analitix/models/analitix_visit_group.py:0
msgid "%(size)s person(s) at %(door)s"
msgstr "%(size)s persona(s) en %(door)s"

#. module: analitix
#. odoo-python
#: code:addons/analitix/models/analitix_value_report.py:0
msgid "%(tickets)s of them bought something — that is %(rate).1f%% of everyone who walked in."
msgstr "%(tickets)s de ellas compraron algo: es el %(rate).1f%% de todo el que entró."

#. module: analitix
#. odoo-python
#: code:addons/analitix/models/analitix_chain.py:0
msgid "%(user)s changed the %(what)s scope from <b>%(old)s</b> to <b>%(new)s</b> for the whole chain."
msgstr "%(user)s cambió el alcance de %(what)s de <b>%(old)s</b> a <b>%(new)s</b> para toda la cadena."

#. module: analitix
#. odoo-python
#: code:addons/analitix/models/analitix_watchlist.py:0
msgid "%(user)s reviewed a match on %(date)s and reported it as the WRONG PERSON. If this keeps happening, the entry's signature is poor and it should be removed rather than re-enrolled."
msgstr "%(user)s revisó una coincidencia del %(date)s y reportó que era la PERSONA EQUIVOCADA. Si esto se repite, la firma de la entrada es mala y conviene retirarla en vez de volver a registrarla."

#. module: analitix
#. odoo-python
#: code:addons/analitix/models/analitix_value_report.py:0
msgid "%(visitors)s people came into the shop."
msgstr "Entraron %(visitors)s personas a la tienda."

#. module: analitix
#. odoo-python
#: code:addons/analitix/models/analitix_lost_sale.py:0
msgid "%(zone)s · %(when)s"
msgstr "%(zone)s · %(when)s"

#. module: analitix
#. odoo-python
#: code:addons/analitix/models/analitix_lost_sale.py:0
msgid "%(zone)s: customer unattended for %(mins)s min"
msgstr "%(zone)s: cliente sin atender desde hace %(mins)s min"

#. module: analitix
#. odoo-python
#: code:addons/analitix/wizards/store_setup.py:0
msgid "%s counter"
msgstr "Contador de %s"

#. module: analitix
#. odoo-python
#: code:addons/analitix/models/analitix_customer_context.py:0
msgid "%s is a returning customer."
msgstr "%s es un cliente recurrente."

#. module: analitix
#: model:ir.model.constraint,message:analitix.constraint_analitix_store_offline_after_degraded
msgid "'Offline After' must be at least as long as 'Degraded After'."
msgstr "'Fuera de línea tras' debe ser al menos tan largo como 'Degradado tras'."

