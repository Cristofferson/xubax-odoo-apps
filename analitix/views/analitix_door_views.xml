<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_door_list" model="ir.ui.view">
        <field name="name">analitix.door.list</field>
        <field name="model">analitix.door</field>
        <field name="arch" type="xml">
            <list string="Doors" decoration-muted="not counts_visitors">
                <field name="sequence" widget="handle"/>
                <field name="store_id"/>
                <field name="name"/>
                <field name="code" optional="show"/>
                <field name="kind"/>
                <field name="counts_visitors"/>
                <field name="device_count" string="Devices"/>
                <field name="visitors_today" sum="Visitors"/>
            </list>
        </field>
    </record>

    <record id="view_door_form" model="ir.ui.view">
        <field name="name">analitix.door.form</field>
        <field name="model">analitix.door</field>
        <field name="arch" type="xml">
            <form string="Door">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_events" type="object"
                                class="oe_stat_button" icon="fa-exchange">
                            <field name="visitors_today" widget="statinfo"
                                   string="Visitors Today"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name" string="Door"/>
                        <h1><field name="name" placeholder="e.g. North Entrance"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="store_id"/>
                            <field name="code"/>
                            <field name="kind"/>
                        </group>
                        <group>
                            <field name="counts_visitors"/>
                            <field name="active"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <div class="alert alert-info" role="alert"
                         invisible="counts_visitors">
                        This door's crossings are recorded but do not count as
                        visitors. Traffic here still shows on the door report; it
                        simply stays out of the store's conversion rate.
                    </div>
                    <notebook>
                        <page string="Devices" name="devices">
                            <field name="device_ids">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="device_uid"/>
                                    <field name="role"/>
                                    <field name="kind"/>
                                    <field name="critical"/>
                                    <field name="status" widget="badge"
                                           decoration-success="status == 'online'"
                                           decoration-danger="status in ('offline', 'never_seen')"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_door_search" model="ir.ui.view">
        <field name="name">analitix.door.search</field>
        <field name="model">analitix.door</field>
        <field name="arch" type="xml">
            <search string="Doors">
                <field name="name"/>
                <field name="store_id"/>
                <filter name="filter_counting" string="Counts Visitors"
                        domain="[('counts_visitors', '=', True)]"/>
                <group name="group_by">
                    <filter name="group_store" string="Store" domain="[]"
                            context="{'group_by': 'store_id'}"/>
                    <filter name="group_kind" string="Type" domain="[]"
                            context="{'group_by': 'kind'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_door" model="ir.actions.act_window">
        <field name="name">Doors</field>
        <field name="res_model">analitix.door</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_group_store': 1}</field>
    </record>

</odoo>
