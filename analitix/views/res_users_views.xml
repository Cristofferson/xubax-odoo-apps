<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_users_form_analitix" model="ir.ui.view">
        <field name="name">res.users.form.analitix</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Analitix" name="analitix"
                      groups="analitix.group_user"
                      invisible="not id">
                    <group>
                        <field name="analitix_store_ids" widget="many2many_tags"
                               options="{'no_create': True}"/>
                        <field name="analitix_region_ids" widget="many2many_tags"
                               options="{'no_create': True}"
                               groups="analitix.group_corporate"/>
                        <field name="analitix_scoped" invisible="1"/>
                        <field name="analitix_scope_store_ids" widget="many2many_tags"
                               readonly="1" invisible="not analitix_scoped"
                               string="Effective Scope"/>
                    </group>
                    <div class="alert alert-info" role="alert">
                        <p class="mb-1">
                            <b>Empty means every store</b> of the companies this user
                            already belongs to. That is the right setting for a
                            customer who runs one store, and it needs no configuration.
                        </p>
                        <p class="mb-1">
                            On a shared instance hosting several customers, fill this
                            in. Once it has any value the user sees <b>only</b> those
                            stores — no group, company switch or manager role widens it.
                        </p>
                        <p class="mb-0">
                            For a chain, give a <b>region</b> rather than a list of
                            stores: it already includes the branches that open next
                            year. A hand-written list of twenty stores is one nobody
                            remembers to extend, and stale access outlives the person
                            it was written for. <b>Effective scope</b> shows what the
                            two settings actually resolve to.
                        </p>
                    </div>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
