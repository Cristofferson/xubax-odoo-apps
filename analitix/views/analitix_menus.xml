<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <menuitem id="menu_root" name="Analitix"
              web_icon="analitix,static/description/icon.png"
              sequence="85" groups="analitix.group_user"/>

    <!-- What the owner opens every morning. -->
    <menuitem id="menu_analysis" name="Analysis" parent="menu_root" sequence="10"/>
    <menuitem id="menu_conversion" name="Conversion" parent="menu_analysis"
              action="action_hourly" sequence="10"/>
    <menuitem id="menu_door_traffic" name="Door Traffic" parent="menu_analysis"
              action="action_door_hourly" sequence="20"/>
    <menuitem id="menu_visitors" name="Visits" parent="menu_analysis"
              action="action_visitor" sequence="25"/>
    <menuitem id="menu_demographics" name="Demographics" parent="menu_analysis"
              action="action_demographic" sequence="27"/>
    <menuitem id="menu_visit_groups" name="Purchase Units" parent="menu_analysis"
              action="action_visit_group" sequence="28"/>
    <menuitem id="menu_lost_sales" name="Lost Sales" parent="menu_analysis"
              action="action_lost_sale" sequence="15"/>
    <menuitem id="menu_zone_dwell" name="Zone Dwell" parent="menu_analysis"
              action="action_zone_dwell" sequence="21"/>
    <menuitem id="menu_poi_performance" name="Display Performance" parent="menu_analysis"
              action="action_poi_performance" sequence="22"/>
    <menuitem id="menu_value_report" name="Monthly Value" parent="menu_analysis"
              action="action_value_report" sequence="5"/>
    <menuitem id="menu_coaching" name="Floor Coaching" parent="menu_analysis"
              action="action_coaching" sequence="23"/>
    <menuitem id="menu_recurrence" name="Visit Frequency" parent="menu_analysis"
              action="action_recurrence" sequence="24"/>
    <menuitem id="menu_stores_overview" name="Stores" parent="menu_analysis"
              action="action_store" sequence="30"/>

    <!-- The salesperson's own list, first thing under the app. -->
    <menuitem id="menu_my_alerts" name="My Alerts" parent="menu_root"
              action="action_alert_mine" sequence="5"/>

    <!-- What the implementer opens when something looks wrong. -->
    <menuitem id="menu_operations" name="Operations" parent="menu_root" sequence="20"
              groups="analitix.group_manager,analitix.group_technician"/>
    <menuitem id="menu_device_health" name="Device Health" parent="menu_operations"
              action="action_device_health" sequence="10"/>
    <menuitem id="menu_all_alerts" name="All Alerts" parent="menu_operations"
              action="action_alert" sequence="15"/>
    <menuitem id="menu_anomalies" name="Behaviour Signals" parent="menu_operations"
              action="action_anomaly" sequence="17"/>
    <menuitem id="menu_sale_match" name="Ticket Attribution" parent="menu_operations"
              action="action_sale_match" sequence="18"/>
    <menuitem id="menu_signage_events" name="Signage Firings" parent="menu_operations"
              action="action_signage_event" sequence="19"/>
    <menuitem id="menu_events" name="Crossing Events" parent="menu_operations"
              action="action_event" sequence="20"/>
    <menuitem id="menu_jobs" name="Background Jobs" parent="menu_operations"
              action="action_job" sequence="30"/>
    <menuitem id="menu_face_signatures" name="Face Signatures" parent="menu_operations"
              action="action_face_signature" sequence="35"
              groups="analitix.group_manager"/>
    <menuitem id="menu_audit" name="Audit Log" parent="menu_operations"
              action="action_audit_log" sequence="40"/>

    <!-- Its own top-level section, visible only to the security role. Not under
         Operations and not under Configuration: it is neither a technical
         health screen nor a store setting, and burying it in either would
         suggest it belongs to whoever already opens those. -->
    <menuitem id="menu_security" name="Security" parent="menu_root" sequence="60"
              groups="analitix.group_security"/>
    <menuitem id="menu_watch_person" name="Watch List" parent="menu_security"
              action="action_watch_person" sequence="10"/>
    <menuitem id="menu_watch_match" name="Matches" parent="menu_security"
              action="action_watch_match" sequence="20"/>

    <menuitem id="menu_configuration" name="Configuration" parent="menu_root"
              sequence="90" groups="analitix.group_manager"/>
    <menuitem id="menu_store_setup" name="New Store Setup" parent="menu_configuration"
              action="action_store_setup" sequence="5"/>
    <menuitem id="menu_config_stores" name="Stores" parent="menu_configuration"
              action="action_store" sequence="10"/>
    <menuitem id="menu_config_doors" name="Doors" parent="menu_configuration"
              action="action_door" sequence="20"/>
    <menuitem id="menu_config_devices" name="Devices" parent="menu_configuration"
              action="action_device" sequence="30"/>
    <menuitem id="menu_config_zones" name="Zones" parent="menu_configuration"
              action="action_zone" sequence="35"/>
    <menuitem id="menu_config_pois" name="Displays" parent="menu_configuration"
              action="action_poi" sequence="37"/>
    <menuitem id="menu_config_signage" name="Signage Rules" parent="menu_configuration"
              action="action_signage_rule" sequence="38"/>
    <menuitem id="menu_config_staff" name="Staff Signatures" parent="menu_configuration"
              action="action_staff_signature" sequence="40"/>

    <!-- Last in the app, where people look for help. The user manual is for
         everybody; the implementation guide is only useful to somebody who can
         actually change the configuration, so it sits behind that group. -->
    <menuitem id="menu_help" name="Help" parent="menu_root" sequence="95"/>
    <menuitem id="menu_help_user" name="User Manual" parent="menu_help"
              action="action_manual_user" sequence="10"/>
    <menuitem id="menu_help_implementer" name="Implementation Guide" parent="menu_help"
              action="action_manual_implementer" sequence="20"
              groups="analitix.group_manager,analitix.group_technician"/>

</odoo>
