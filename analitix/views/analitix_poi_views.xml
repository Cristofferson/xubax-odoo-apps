<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_poi_list" model="ir.ui.view">
        <field name="name">analitix.poi.list</field>
        <field name="model">analitix.poi</field>
        <field name="arch" type="xml">
            <list string="Displays">
                <field name="sequence" widget="handle"/>
                <field name="store_id"/>
                <field name="zone_id"/>
                <field name="name"/>
                <field name="code" optional="show"/>
                <field name="stop_seconds"/>
                <field name="product_ids" widget="many2many_tags" optional="show"/>
                <field name="stops_today" sum="Stops"/>
                <field name="avg_seconds_today" avg="Avg stop"/>
            </list>
        </field>
    </record>

    <record id="view_poi_form" model="ir.ui.view">
        <field name="name">analitix.poi.form</field>
        <field name="model">analitix.poi</field>
        <field name="arch" type="xml">
            <form string="Display">
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Display"/>
                        <h1><field name="name" placeholder="e.g. Window Showcase"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="zone_id"/>
                            <field name="store_id" readonly="1"/>
                            <field name="code"/>
                            <field name="stop_seconds"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="stops_today"/>
                            <field name="avg_seconds_today"/>
                        </group>
                    </group>
                    <group string="What is physically on it">
                        <field name="product_ids" widget="many2many_tags" nolabel="1"/>
                    </group>
                    <div class="alert alert-info" role="alert">
                        Attention on its own is a vanity metric. Attention
                        crossed with the sales of the products actually on this
                        display is what produces the two findings worth acting
                        on: <b>lots of attention and few sales</b> (price, or
                        nobody closing) and <b>few visitors but good sales</b>
                        (it converts everyone who finds it — move it somewhere
                        warmer). Only the shop knows what is on it, so this list
                        is configuration.
                    </div>
                    <group string="Notes">
                        <field name="note" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_poi_search" model="ir.ui.view">
        <field name="name">analitix.poi.search</field>
        <field name="model">analitix.poi</field>
        <field name="arch" type="xml">
            <search string="Displays">
                <field name="name"/>
                <field name="zone_id"/>
                <field name="store_id"/>
                <filter name="filter_unmapped" string="No Products Attached"
                        domain="[('product_ids', '=', False)]"
                        help="Attention here cannot be compared against sales until somebody says what is on the display."/>
                <group name="group_by">
                    <filter name="group_zone" string="Zone" domain="[]"
                            context="{'group_by': 'zone_id'}"/>
                    <filter name="group_store" string="Store" domain="[]"
                            context="{'group_by': 'store_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_poi" model="ir.actions.act_window">
        <field name="name">Displays</field>
        <field name="res_model">analitix.poi</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_group_zone': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Map your displays</p>
            <p>
                Zones answer "where do people go". Displays answer "what do they
                stop at", which is finer and more commercially useful. Attach
                the products that sit on each one and the ranking becomes
                actionable rather than merely interesting.
            </p>
        </field>
    </record>

    <!-- Attention vs sales -->
    <record id="view_poi_performance_list" model="ir.ui.view">
        <field name="name">analitix.poi.performance.list</field>
        <field name="model">analitix.poi.performance</field>
        <field name="arch" type="xml">
            <list string="Display Performance" create="false" edit="false">
                <field name="day"/>
                <field name="store_id"/>
                <field name="zone_id"/>
                <field name="poi_id"/>
                <field name="stops" sum="Stops"/>
                <field name="attention_seconds" sum="Attention (s)"/>
                <field name="units_sold" sum="Units"/>
                <field name="revenue" sum="Revenue" widget="monetary"/>
                <field name="units_per_stop" avg="Units / stop"/>
                <field name="currency_id" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="view_poi_performance_pivot" model="ir.ui.view">
        <field name="name">analitix.poi.performance.pivot</field>
        <field name="model">analitix.poi.performance</field>
        <field name="arch" type="xml">
            <pivot string="Display Performance" sample="1">
                <field name="poi_id" type="row"/>
                <field name="stops" type="measure"/>
                <field name="units_sold" type="measure"/>
                <field name="revenue" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_poi_performance_search" model="ir.ui.view">
        <field name="name">analitix.poi.performance.search</field>
        <field name="model">analitix.poi.performance</field>
        <field name="arch" type="xml">
            <search string="Display Performance">
                <field name="poi_id"/>
                <field name="zone_id"/>
                <field name="store_id"/>
                <filter name="filter_attention_no_sales"
                        string="Draws A Crowd, Sells Little"
                        domain="[('stops', '&gt;', 10), ('units_sold', '=', 0)]"
                        help="People stop and walk away. Almost always price, or nobody closing."/>
                <filter name="filter_sells_cold"
                        string="Sells Well, Few Visitors"
                        domain="[('units_sold', '&gt;', 0), ('stops', '&lt;', 5)]"
                        help="It converts everyone who finds it and it is in a cold corner. Move it."/>
                <separator/>
                <filter name="filter_30d" string="Last 30 Days"
                        domain="[('day', '&gt;=', (context_today() - datetime.timedelta(days=30)).strftime('%Y-%m-%d'))]"/>
                <group name="group_by">
                    <filter name="group_poi" string="Display" domain="[]"
                            context="{'group_by': 'poi_id'}"/>
                    <filter name="group_zone" string="Zone" domain="[]"
                            context="{'group_by': 'zone_id'}"/>
                    <filter name="group_day" string="Day" domain="[]"
                            context="{'group_by': 'day'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_poi_performance" model="ir.actions.act_window">
        <field name="name">Display Performance</field>
        <field name="res_model">analitix.poi.performance</field>
        <field name="view_mode">pivot,list</field>
        <field name="context">{'search_default_filter_30d': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No display data yet</p>
            <p>
                Attention beside the sales of the products on each display. A
                product sitting on two displays counts on both — honest, because
                the data genuinely cannot say which one closed the sale, and
                splitting it would invent a precision that does not exist.
            </p>
        </field>
    </record>

</odoo>
