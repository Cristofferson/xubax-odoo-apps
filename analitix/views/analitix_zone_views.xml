<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_zone_list" model="ir.ui.view">
        <field name="name">analitix.zone.list</field>
        <field name="model">analitix.zone</field>
        <field name="arch" type="xml">
            <list string="Zones" decoration-muted="not alert_on_dwell">
                <field name="sequence" widget="handle"/>
                <field name="store_id"/>
                <field name="name"/>
                <field name="code" optional="show"/>
                <field name="kind"/>
                <field name="engaged_seconds"/>
                <field name="lost_sale_seconds"/>
                <field name="alert_on_dwell"/>
                <field name="visitors_today" sum="Visits"/>
                <field name="avg_dwell_today" avg="Avg dwell"/>
            </list>
        </field>
    </record>

    <record id="view_zone_form" model="ir.ui.view">
        <field name="name">analitix.zone.form</field>
        <field name="model">analitix.zone</field>
        <field name="arch" type="xml">
            <form string="Zone">
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Zone"/>
                        <h1><field name="name" placeholder="e.g. Engagement Rings"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="store_id"/>
                            <field name="code"/>
                            <field name="kind"/>
                            <field name="area_sqm"/>
                            <field name="active"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group string="Thresholds">
                            <field name="engaged_seconds"/>
                            <field name="lost_sale_seconds"/>
                            <field name="alert_on_dwell"/>
                            <field name="screen_group_ref"
                                   placeholder="Xibo display group"/>
                        </group>
                    </group>
                    <div class="alert alert-info" role="alert"
                         invisible="alert_on_dwell">
                        Long dwell here raises no nudge. Right for a fitting
                        room or a checkout queue, where lingering is the shape
                        of the activity rather than a sign that somebody is
                        being ignored.
                    </div>
                    <notebook>
                        <page string="Shift Coverage" name="coverage">
                            <p class="text-muted">
                                Who gets the discreet nudge for this zone, and when.
                                Whoever covers the counter at 11:00 is not whoever
                                covers it at 19:00 — if nobody is rostered at the
                                moment an alert fires, it escalates to the store's
                                fallback rather than evaporating.
                            </p>
                            <field name="vendor_ids">
                                <list editable="bottom">
                                    <field name="user_id"/>
                                    <field name="weekday"/>
                                    <field name="hour_from" widget="float_time"/>
                                    <field name="hour_to" widget="float_time"/>
                                    <field name="active"/>
                                </list>
                            </field>
                        </page>
                        <page string="Displays" name="pois">
                            <field name="poi_ids">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="code"/>
                                    <field name="stop_seconds"/>
                                    <field name="product_ids" widget="many2many_tags"/>
                                    <field name="stops_today"/>
                                </list>
                            </field>
                        </page>
                        <page string="Cameras" name="devices">
                            <field name="device_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="device_uid"/>
                                    <field name="role"/>
                                    <field name="status" widget="badge"
                                           decoration-success="status == 'online'"
                                           decoration-danger="status in ('offline', 'never_seen')"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_zone_search" model="ir.ui.view">
        <field name="name">analitix.zone.search</field>
        <field name="model">analitix.zone</field>
        <field name="arch" type="xml">
            <search string="Zones">
                <field name="name"/>
                <field name="store_id"/>
                <filter name="filter_alerting" string="Nudges On Long Dwell"
                        domain="[('alert_on_dwell', '=', True)]"/>
                <group name="group_by">
                    <filter name="group_store" string="Store" domain="[]"
                            context="{'group_by': 'store_id'}"/>
                    <filter name="group_kind" string="Type" domain="[]"
                            context="{'group_by': 'kind'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_zone" model="ir.actions.act_window">
        <field name="name">Zones</field>
        <field name="res_model">analitix.zone</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_group_store': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Divide the floor</p>
            <p>
                "Twelve minutes inside" tells an owner nothing. "Eleven of those
                twelve in front of the engagement rings, and nobody spoke to
                them" tells them exactly where the money went.
            </p>
        </field>
    </record>

    <!-- Dwell -->
    <record id="view_zone_dwell_list" model="ir.ui.view">
        <field name="name">analitix.zone.dwell.list</field>
        <field name="model">analitix.zone.dwell</field>
        <field name="arch" type="xml">
            <list string="Zone Dwell" create="false"
                  decoration-warning="engaged and not served">
                <field name="entered_at"/>
                <field name="store_id"/>
                <field name="zone_id"/>
                <field name="visitor_id" optional="show"/>
                <field name="seconds" sum="Seconds"/>
                <field name="engaged"/>
                <field name="served"/>
                <field name="alert_id" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_zone_dwell_pivot" model="ir.ui.view">
        <field name="name">analitix.zone.dwell.pivot</field>
        <field name="model">analitix.zone.dwell</field>
        <field name="arch" type="xml">
            <pivot string="Zone Dwell" sample="1">
                <field name="zone_id" type="row"/>
                <field name="entered_at" interval="day" type="col"/>
                <field name="seconds" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_zone_dwell_search" model="ir.ui.view">
        <field name="name">analitix.zone.dwell.search</field>
        <field name="model">analitix.zone.dwell</field>
        <field name="arch" type="xml">
            <search string="Zone Dwell">
                <field name="zone_id"/>
                <field name="store_id"/>
                <filter name="filter_engaged" string="Engaged"
                        domain="[('engaged', '=', True)]"/>
                <filter name="filter_unserved" string="Nobody Went Over"
                        domain="[('engaged', '=', True), ('served', '=', False)]"/>
                <filter name="filter_7d" string="Last 7 Days"
                        domain="[('entered_at', '&gt;=', (context_today() - datetime.timedelta(days=7)).strftime('%Y-%m-%d'))]"/>
                <group name="group_by">
                    <filter name="group_zone" string="Zone" domain="[]"
                            context="{'group_by': 'zone_id'}"/>
                    <filter name="group_store" string="Store" domain="[]"
                            context="{'group_by': 'store_id'}"/>
                    <filter name="group_day" string="Day" domain="[]"
                            context="{'group_by': 'entered_at:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_zone_dwell" model="ir.actions.act_window">
        <field name="name">Zone Dwell</field>
        <field name="res_model">analitix.zone.dwell</field>
        <field name="view_mode">pivot,list</field>
        <field name="context">{'search_default_filter_7d': 1, 'search_default_group_zone': 1}</field>
    </record>

    <!-- Behaviour signals -->
    <record id="view_anomaly_list" model="ir.ui.view">
        <field name="name">analitix.anomaly.event.list</field>
        <field name="model">analitix.anomaly.event</field>
        <field name="arch" type="xml">
            <list string="Behaviour Signals" create="false">
                <field name="detected_at"/>
                <field name="store_id"/>
                <field name="zone_id"/>
                <field name="kind"/>
                <field name="detail"/>
                <field name="outcome" widget="badge"
                       decoration-success="outcome in ('nothing', 'served')"
                       decoration-danger="outcome == 'incident'"/>
            </list>
        </field>
    </record>

    <record id="view_anomaly_form" model="ir.ui.view">
        <field name="name">analitix.anomaly.event.form</field>
        <field name="model">analitix.anomaly.event</field>
        <field name="arch" type="xml">
            <form string="Behaviour Signal" create="false">
                <sheet>
                    <div class="alert alert-info" role="alert">
                        This is a <b>behaviour</b> signal, not an accusation and
                        not a person. It carries no identity, it expires with the
                        visit it came from, and most of the time the honest
                        outcome is "nothing in it" or "they just needed help" —
                        recording those is what lets a store see whether its
                        thresholds are set sensibly.
                    </div>
                    <group>
                        <group>
                            <field name="store_id"/>
                            <field name="zone_id"/>
                            <field name="kind"/>
                            <field name="detected_at"/>
                        </group>
                        <group>
                            <field name="visitor_id"/>
                            <field name="visit_group_id"/>
                            <field name="alert_id"/>
                            <field name="outcome"/>
                        </group>
                    </group>
                    <group string="Detail">
                        <field name="detail" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_anomaly_search" model="ir.ui.view">
        <field name="name">analitix.anomaly.event.search</field>
        <field name="model">analitix.anomaly.event</field>
        <field name="arch" type="xml">
            <search string="Behaviour Signals">
                <field name="store_id"/>
                <field name="zone_id"/>
                <filter name="filter_pending" string="Not Reviewed"
                        domain="[('outcome', '=', 'pending')]"/>
                <filter name="filter_7d" string="Last 7 Days"
                        domain="[('detected_at', '&gt;=', (context_today() - datetime.timedelta(days=7)).strftime('%Y-%m-%d'))]"/>
                <group name="group_by">
                    <filter name="group_kind" string="Signal" domain="[]"
                            context="{'group_by': 'kind'}"/>
                    <filter name="group_outcome" string="Outcome" domain="[]"
                            context="{'group_by': 'outcome'}"/>
                    <filter name="group_store" string="Store" domain="[]"
                            context="{'group_by': 'store_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_anomaly" model="ir.actions.act_window">
        <field name="name">Behaviour Signals</field>
        <field name="res_model">analitix.anomaly.event</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_filter_7d': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Nothing flagged</p>
            <p>
                Patterns worth a second look — in and out repeatedly, a long stop
                at an expensive case with nobody nearby, a group that arrives
                together and scatters. <b>Anonymous, and about behaviour rather
                than people.</b> The named watch list is a separate feature with
                its own controls.
            </p>
        </field>
    </record>

</odoo>
