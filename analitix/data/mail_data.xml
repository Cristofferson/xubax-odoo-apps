<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Sent to a store's technical contacts when a *critical* device goes
             dark. Written for someone reading it on a phone: what broke, where,
             since when, and what it costs to leave it broken. -->
        <record id="mail_template_device_offline" model="mail.template">
            <field name="name">Analitix: critical device offline</field>
            <field name="model_id" ref="model_analitix_device"/>
            <field name="subject">[Analitix] {{ object.store_id.name }} — {{ object.name }} is offline</field>
            <field name="email_from">{{ (object.company_id.email or user.email_formatted) }}</field>
            <field name="partner_to">{{ ','.join(str(pid) for pid in ctx.get('alert_partner_ids', [])) }}</field>
            <field name="auto_delete" eval="False"/>
            <field name="body_html" type="html">
                <div style="font-family:Arial,Helvetica,sans-serif;font-size:14px;color:#333;">
                    <p style="font-size:16px;margin:0 0 12px 0;">
                        <strong t-out="object.name">Device</strong> stopped reporting.
                    </p>
                    <table style="border-collapse:collapse;margin:0 0 16px 0;">
                        <tr>
                            <td style="padding:4px 12px 4px 0;color:#777;">Store</td>
                            <td style="padding:4px 0;"><t t-out="object.store_id.name">Store</t></td>
                        </tr>
                        <tr>
                            <td style="padding:4px 12px 4px 0;color:#777;">Door</td>
                            <td style="padding:4px 0;"><t t-out="object.door_id.name or '—'">Door</t></td>
                        </tr>
                        <tr>
                            <td style="padding:4px 12px 4px 0;color:#777;">Device UID</td>
                            <td style="padding:4px 0;"><t t-out="object.device_uid">uid</t></td>
                        </tr>
                        <tr>
                            <td style="padding:4px 12px 4px 0;color:#777;">Last heartbeat</td>
                            <td style="padding:4px 0;"><t t-out="object.last_heartbeat or 'never'">-</t> UTC</td>
                        </tr>
                    </table>
                    <p style="margin:0 0 12px 0;">
                        While this device is down, the store's visitor count and
                        conversion rate are incomplete — the numbers on the
                        dashboard understate reality and should not be used for
                        decisions until it is back.
                    </p>
                    <p style="margin:0;color:#777;font-size:12px;">
                        Usual causes, in the order they are usually found: the
                        mini-PC lost power, the store's internet is down, or the
                        camera was unplugged during cleaning.
                    </p>
                </div>
            </field>
            <field name="lang">{{ object.company_id.partner_id.lang }}</field>
        </record>

    </data>
</odoo>
