<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Silence is the failure mode that no inbound request can report,
             so it has to be polled. Every minute: a store paying for live
             conversion should not learn at closing time that its counter died
             at ten in the morning. -->
        <record id="cron_device_health" model="ir.cron">
            <field name="name">Analitix: check device health</field>
            <field name="model_id" ref="model_analitix_device"/>
            <field name="state">code</field>
            <field name="code">model._cron_check_health()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>

        <record id="cron_run_jobs" model="ir.cron">
            <field name="name">Analitix: run background jobs</field>
            <field name="model_id" ref="model_analitix_job"/>
            <field name="state">code</field>
            <field name="code">model._cron_run()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>

        <record id="cron_vacuum_jobs" model="ir.cron">
            <field name="name">Analitix: clean finished jobs</field>
            <field name="model_id" ref="model_analitix_job"/>
            <field name="state">code</field>
            <field name="code">model._cron_vacuum()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>

        <!-- Hourly, because the baseline it maintains is an hourly rate and
             sampling it faster would just add noise. -->
        <record id="cron_ingest_baselines" model="ir.cron">
            <field name="name">Analitix: refresh ingest baselines and flag anomalies</field>
            <field name="model_id" ref="model_analitix_device"/>
            <field name="state">code</field>
            <field name="code">model._cron_update_baselines()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="active" eval="True"/>
        </record>

        <record id="cron_event_retention" model="ir.cron">
            <field name="name">Analitix: apply event retention policy</field>
            <field name="model_id" ref="model_analitix_event"/>
            <field name="state">code</field>
            <field name="code">model._cron_apply_retention()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>

        <!-- Retention is a promise, not housekeeping: an anonymous face vector
             that is never deleted stops being short-lived data and becomes a
             biometric database nobody agreed to. Every 15 minutes so a store
             with a 30-minute window is honoured to the minute it claims. -->
        <record id="cron_expire_signatures" model="ir.cron">
            <field name="name">Analitix: expire anonymous face signatures</field>
            <field name="model_id" ref="model_analitix_face_signature"/>
            <field name="state">code</field>
            <field name="code">model._cron_expire()</field>
            <field name="interval_number">15</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>

        <record id="cron_close_stale_visits" model="ir.cron">
            <field name="name">Analitix: close visits whose exit was missed</field>
            <field name="model_id" ref="model_analitix_visitor"/>
            <field name="state">code</field>
            <field name="code">model._cron_close_stale()</field>
            <field name="interval_number">30</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>

        <!-- An unacknowledged nudge becomes evidence rather than noise: a
             coaching report that only ever saw the alerts that went well would
             be the most flattering and least useful version of the truth. -->
        <record id="cron_alerts_missed" model="ir.cron">
            <field name="name">Analitix: mark unacknowledged alerts as missed</field>
            <field name="model_id" ref="model_analitix_alert"/>
            <field name="state">code</field>
            <field name="code">model._cron_mark_missed()</field>
            <field name="interval_number">10</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>

        <record id="cron_settle_lost_sales" model="ir.cron">
            <field name="name">Analitix: settle open lost sales</field>
            <field name="model_id" ref="model_analitix_lost_sale"/>
            <field name="state">code</field>
            <field name="code">model._cron_settle_open()</field>
            <field name="interval_number">30</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>

        <!-- Two of the three behaviour signals only exist over a window of
             time, so they are swept rather than evaluated on every crossing. -->
        <record id="cron_anomaly_scan" model="ir.cron">
            <field name="name">Analitix: scan for unusual behaviour</field>
            <field name="model_id" ref="model_analitix_anomaly_event"/>
            <field name="state">code</field>
            <field name="code">model._cron_scan()</field>
            <field name="interval_number">5</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>

        <!-- The report that shows the subscription paying for itself. Runs on
             the 2nd so a month that ended at midnight is fully settled. -->
        <record id="cron_value_report" model="ir.cron">
            <field name="name">Analitix: send the monthly value report</field>
            <field name="model_id" ref="model_analitix_value_report"/>
            <field name="state">code</field>
            <field name="code">model._cron_monthly()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="nextcall" eval="(DateTime.now().replace(day=2, hour=6, minute=0, second=0) + relativedelta(months=1)).strftime('%Y-%m-%d %H:%M:%S')"/>
            <field name="active" eval="True"/>
        </record>

        <record id="cron_check_trials" model="ir.cron">
            <field name="name">Analitix: flag trials that have ended</field>
            <field name="model_id" ref="model_analitix_store"/>
            <field name="state">code</field>
            <field name="code">model._cron_check_trials()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>

        <record id="cron_close_attendance" model="ir.cron">
            <field name="name">Analitix: close shifts nobody was seen leaving</field>
            <field name="model_id" ref="model_analitix_attendance"/>
            <field name="state">code</field>
            <field name="code">model._cron_close_forgotten()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="active" eval="True"/>
        </record>

    </data>
</odoo>
