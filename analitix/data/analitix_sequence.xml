<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Handles for anonymous signatures. A sequence rather than the record
             id so the reference stays stable in a log after the row itself has
             been expired and deleted, and so nothing about it hints at how many
             people the store has seen. -->
        <record id="seq_face_signature" model="ir.sequence">
            <field name="name">Analitix Face Signature</field>
            <field name="code">analitix.face.signature</field>
            <field name="prefix">V</field>
            <field name="padding">8</field>
            <field name="company_id" eval="False"/>
        </record>

    </data>
</odoo>
