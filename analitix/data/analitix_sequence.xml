<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Handles for anonymous signatures. A sequence rather than the record
             id so the reference stays stable in a log after the row itself has
             been expired and deleted, and so nothing about it hints at how many
             people the store has seen. -->
        <record id="seq_face_signature" model="ir.sequence">
            <field name="name">Analitix Face Signature</field>
            <field name="code">analitix.face.signature</field>
            <field name="prefix">V</field>
            <field name="padding">8</field>
            <field name="company_id" eval="False"/>
        </record>

        <!-- Watch-list handles. Opaque on purpose: staff acting on an alert
             need to know that somebody is worth a second look, not to have a
             name to circulate. -->
        <record id="seq_watch_person" model="ir.sequence">
            <field name="name">Analitix Watch-list Entry</field>
            <field name="code">analitix.watch.person</field>
            <field name="prefix">W</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

    </data>
</odoo>
