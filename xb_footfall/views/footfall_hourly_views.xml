<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_footfall_hourly_list" model="ir.ui.view">
        <field name="name">xb.footfall.hourly.list</field>
        <field name="model">xb.footfall.hourly</field>
        <field name="arch" type="xml">
            <list>
                <field name="hour"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="visitors_in"/>
                <field name="visitors_out"/>
                <field name="tickets"/>
                <field name="revenue"/>
                <field name="conversion_rate" widget="percentage" optional="show"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_footfall_hourly_graph" model="ir.ui.view">
        <field name="name">xb.footfall.hourly.graph</field>
        <field name="model">xb.footfall.hourly</field>
        <field name="arch" type="xml">
            <graph string="Footfall vs Conversion" type="line">
                <field name="hour" interval="hour"/>
                <field name="visitors_in" type="measure"/>
                <field name="tickets" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="view_footfall_hourly_pivot" model="ir.ui.view">
        <field name="name">xb.footfall.hourly.pivot</field>
        <field name="model">xb.footfall.hourly</field>
        <field name="arch" type="xml">
            <pivot string="Footfall &amp; Conversion">
                <field name="company_id" type="row"/>
                <field name="hour" interval="day" type="col"/>
                <field name="visitors_in" type="measure"/>
                <field name="tickets" type="measure"/>
                <field name="conversion_rate" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_footfall_hourly_search" model="ir.ui.view">
        <field name="name">xb.footfall.hourly.search</field>
        <field name="model">xb.footfall.hourly</field>
        <field name="arch" type="xml">
            <search>
                <field name="company_id"/>
                <group expand="0" string="Group By">
                    <filter name="g_company" string="Store" context="{'group_by':'company_id'}"/>
                    <filter name="g_hour" string="Hour" context="{'group_by':'hour:hour'}"/>
                    <filter name="g_day" string="Day" context="{'group_by':'hour:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_footfall_hourly" model="ir.actions.act_window">
        <field name="name">Footfall &amp; Conversion</field>
        <field name="res_model">xb.footfall.hourly</field>
        <field name="view_mode">graph,pivot,list</field>
    </record>

</odoo>
