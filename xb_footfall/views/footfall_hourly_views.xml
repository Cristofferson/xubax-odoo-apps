<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_footfall_hourly_list" model="ir.ui.view">
        <field name="name">xb.footfall.hourly.list</field>
        <field name="model">xb.footfall.hourly</field>
        <field name="arch" type="xml">
            <list>
                <field name="hour"/>
                <field name="store_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="visitors_in"/>
                <field name="visitors_out"/>
                <field name="tickets"/>
                <field name="units" optional="show"/>
                <field name="revenue"/>
                <field name="conversion_rate" widget="percentage" optional="show"/>
                <field name="atv" optional="show"/>
                <field name="upt" optional="hide"/>
                <field name="revenue_per_visitor" optional="show"/>
                <field name="visitors_per_ticket" optional="hide"/>
                <field name="visitors_per_unit" optional="hide"/>
                <field name="revenue_per_sqm" optional="hide"/>
                <field name="visitors_per_sqm" optional="hide"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_footfall_hourly_graph" model="ir.ui.view">
        <field name="name">xb.footfall.hourly.graph</field>
        <field name="model">xb.footfall.hourly</field>
        <field name="arch" type="xml">
            <graph string="Footfall vs Conversion" type="line">
                <field name="hour" interval="hour"/>
                <field name="visitors_in" type="measure"/>
                <field name="tickets" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="view_footfall_hourly_pivot" model="ir.ui.view">
        <field name="name">xb.footfall.hourly.pivot</field>
        <field name="model">xb.footfall.hourly</field>
        <field name="arch" type="xml">
            <pivot string="Footfall &amp; Conversion">
                <field name="store_id" type="row"/>
                <field name="hour" interval="day" type="col"/>
                <field name="visitors_in" type="measure"/>
                <field name="tickets" type="measure"/>
                <field name="units" type="measure"/>
                <field name="revenue" type="measure"/>
                <field name="conversion_rate" type="measure"/>
                <field name="revenue_per_visitor" type="measure"/>
                <field name="revenue_per_sqm" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_footfall_hourly_search" model="ir.ui.view">
        <field name="name">xb.footfall.hourly.search</field>
        <field name="model">xb.footfall.hourly</field>
        <field name="arch" type="xml">
            <search>
                <field name="store_id"/>
                <field name="company_id"/>
                <group>
                    <filter name="g_store" string="Store" domain="[]" context="{'group_by': 'store_id'}"/>
                    <filter name="g_company" string="Company" domain="[]" context="{'group_by': 'company_id'}"/>
                    <filter name="g_hour" string="Hour" domain="[]" context="{'group_by': 'hour:hour'}"/>
                    <filter name="g_day" string="Day" domain="[]" context="{'group_by': 'hour:day'}"/>
                    <filter name="g_weekday" string="Weekday" domain="[]" context="{'group_by': 'hour:day_of_week'}"/>
                    <filter name="g_hod" string="Hour of Day" domain="[]" context="{'group_by': 'hour:hour_number'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_footfall_hourly" model="ir.actions.act_window">
        <field name="name">Footfall &amp; Conversion</field>
        <field name="res_model">xb.footfall.hourly</field>
        <field name="view_mode">graph,pivot,list</field>
    </record>

    <!-- Peak hours heatmap: weekday x hour-of-day, in the user's timezone.
         Reuses the hourly view; the granularities do the tz conversion. -->
    <record id="view_footfall_peak_pivot" model="ir.ui.view">
        <field name="name">xb.footfall.peak.pivot</field>
        <field name="model">xb.footfall.hourly</field>
        <field name="arch" type="xml">
            <pivot string="Peak Hours">
                <field name="visitors_in" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="action_footfall_peak" model="ir.actions.act_window">
        <field name="name">Peak Hours</field>
        <field name="res_model">xb.footfall.hourly</field>
        <field name="view_mode">pivot,graph,list</field>
        <field name="view_id" ref="view_footfall_peak_pivot"/>
        <field name="context">{
            'pivot_row_groupby': ['hour:day_of_week'],
            'pivot_column_groupby': ['hour:hour_number'],
            'pivot_measures': ['visitors_in'],
        }</field>
    </record>

</odoo>
