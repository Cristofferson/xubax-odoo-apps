#. module: xb_pos_taecel
#: model_terms:ir.ui.view,arch_db:xb_pos_taecel.report_deposit_body
msgid ""
"<b>Transfer:</b> put the reference in the payment description.<br/>\n"
"                <b>Practicaja:</b> type the reference into the payment description.<br/>\n"
"                <b>Teller:</b> tell the clerk you are adding a reference to the\n"
"                payment, and give them the number."
msgstr "<b>Transferencia:</b> pon la referencia en el motivo de pago.<br/> <b>Practicaja:</b> captura la referencia en el motivo de pago.<br/> <b>Ventanilla:</b> indícale al cajero que vas a agregar una referencia al pago y dale el número."

#. module: xb_pos_taecel
#: model_terms:ir.ui.view,arch_db:xb_pos_taecel.report_deposit_body
