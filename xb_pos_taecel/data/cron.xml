<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Dispatches transactions parked in draft at POS payment: RequestTXN,
         then polls StatusTXN to settle. Runs every minute so airtime reaches
         the phone promptly. Never re-sends: dispatch moves draft->sent. -->
    <record id="cron_taecel_dispatch" model="ir.cron">
        <field name="name">Recharges: dispatch pending recharges</field>
        <field name="model_id" ref="model_xb_taecel_transaction"/>
        <field name="state">code</field>
        <field name="code">model._cron_dispatch()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
    </record>

    <!-- Resolves sales whose outcome TAECEL never confirmed at the till, by
         matching them in getSales. Runs often on purpose: querying is
         read-only and idempotent, and until it runs the till has a sale nobody
         can account for. -->
    <record id="cron_taecel_reconcile" model="ir.cron">
        <field name="name">Recharges: reconcile pending transactions</field>
        <field name="model_id" ref="model_xb_taecel_transaction"/>
        <field name="state">code</field>
        <field name="code">model._cron_reconcile()</field>
        <field name="interval_number">5</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
    </record>

    <!-- Refreshes every wallet from a single getBalance call (one row per
         bolsa). Direct and accurate; getSales is left to reconciliation. -->
    <record id="cron_taecel_balance" model="ir.cron">
        <field name="name">Recharges: refresh wallet balances</field>
        <field name="model_id" ref="model_xb_taecel_account"/>
        <field name="state">code</field>
        <field name="code">model._cron_refresh_balance()</field>
        <field name="interval_number">30</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
    </record>

</odoo>
