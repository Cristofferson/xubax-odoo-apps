<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="xb_pos_taecel.SaleDialog">
        <Dialog title="dialogTitle" size="'lg'">
            <div class="xb-taecel-dialog">

                <!-- Step 1: carrier -->
                <t t-if="state.step === 'carrier'">
                    <div class="xb-taecel-search">
                        <input type="text" inputmode="search" autocomplete="off" class="form-control form-control-lg"
                               t-att-tabindex="searchTabIndex"
                               placeholder="Search company or service..."
                               t-model="state.search"/>
                        <button t-if="state.search" class="btn btn-link xb-taecel-search-clear"
                                t-on-click="clearSearch">&#215;</button>
                    </div>
                    <t t-foreach="carrierSections" t-as="section" t-key="section.key">
                        <div t-if="section.title" class="xb-taecel-group-title" t-esc="section.title"/>
                        <div t-if="section.tabs" class="xb-taecel-tabs">
                            <t t-foreach="categories" t-as="category" t-key="category">
                                <button class="btn"
                                        t-att-class="category === activeTab ? 'btn-primary' : 'btn-outline-secondary'"
                                        t-on-click="() => this.selectTab(category)"
                                        t-esc="categoryLabel(category)"/>
                            </t>
                        </div>
                        <div class="xb-taecel-grid">
                            <t t-foreach="section.carriers" t-as="carrier" t-key="carrier.id">
                                <button class="xb-taecel-card"
                                        t-att-class="{ 'xb-taecel-card-blocked': isCarrierBlocked(carrier) }"
                                        t-att-disabled="isCarrierBlocked(carrier) or false"
                                        t-on-click="() => this.selectCarrier(carrier)">
                                    <img t-if="carrier.logo_url" t-att-src="carrier.logo_url"
                                         class="xb-taecel-logo" t-att-alt="carrier.name"/>
                                    <span t-esc="carrier.name"/>
                                    <small t-if="isCarrierBlocked(carrier)" class="xb-taecel-card-note">
                                        No balance
                                    </small>
                                </button>
                            </t>
                        </div>
                        <p t-if="section.key === 'search' and !section.carriers.length" class="text-muted my-2">
                            Nothing found. Try another word.
                        </p>
                    </t>
                </t>

                <!-- Step 2: amount (catalog carriers) -->
                <t t-if="state.step === 'amount'">
                    <div class="xb-taecel-header">
                        <button class="btn btn-link p-0" t-on-click="back">&#8592; Back</button>
                        <span class="fw-bolder" t-esc="state.carrier.name"/>
                    </div>
                    <div class="xb-taecel-grid">
                        <t t-foreach="products" t-as="product" t-key="product.id">
                            <button class="xb-taecel-amount"
                                    t-att-class="{ 'xb-taecel-card-blocked': isAmountBlocked(product.amount) }"
                                    t-att-disabled="isAmountBlocked(product.amount) or false"
                                    t-on-click="() => this.selectProduct(product)">
                                <span class="xb-taecel-amount-value"
                                      t-esc="formatCurrency(product.amount)"/>
                                <small t-if="product.validity" t-esc="product.validity"/>
                            </button>
                        </t>
                    </div>
                    <p t-if="!products.length" class="text-muted">
                        No amounts available for this carrier.
                    </p>
                </t>

                <!-- Step 3: reference -->
                <t t-if="state.step === 'reference'">
                    <div class="xb-taecel-header">
                        <button class="btn btn-link p-0" t-on-click="back">&#8592; Back</button>
                        <span class="fw-bolder" t-esc="state.carrier.name"/>
                    </div>

                    <div t-if="!isCatalog" class="mb-2">
                        <label class="form-label">Amount</label>
                        <input type="number" min="0" step="1" class="form-control form-control-lg"
                               t-model.number="state.amount"/>
                    </div>

                    <div class="mb-2">
                        <label class="form-label" t-esc="state.carrier.field_label || 'Reference'"/>
                        <input type="text" class="form-control form-control-lg"
                               t-att-inputmode="state.carrier.field_format === '1' ? 'numeric' : 'text'"
                               t-att-maxlength="state.carrier.field_max or false"
                               t-model="state.reference" autofocus="autofocus"/>
                    </div>

                    <div t-if="state.carrier.field_confirm" class="mb-2">
                        <label class="form-label">Confirm</label>
                        <input type="text" class="form-control form-control-lg"
                               t-att-inputmode="state.carrier.field_format === '1' ? 'numeric' : 'text'"
                               t-att-maxlength="state.carrier.field_max or false"
                               t-model="state.referenceConfirm"/>
                    </div>

                    <div class="xb-taecel-summary">
                        <div class="d-flex justify-content-between">
                            <span>Amount</span>
                            <span t-esc="formatCurrency(state.amount)"/>
                        </div>
                        <div t-foreach="feeParts" t-as="part" t-key="part[0]" class="d-flex justify-content-between">
                            <span t-esc="part[0]"/>
                            <span t-esc="formatCurrency(part[1])"/>
                        </div>
                        <div class="d-flex justify-content-between fw-bolder xb-taecel-total">
                            <span>Total</span>
                            <span t-esc="formatCurrency(total)"/>
                        </div>
                    </div>

                    <div t-if="walletShortfall" class="alert alert-danger py-1 my-2"
                         t-esc="walletShortfall"/>
                    <div t-elif="walletWarning" class="alert alert-warning py-1 my-2"
                         t-esc="walletWarning"/>
                    <div t-if="state.error" class="alert alert-danger py-1 my-2" t-esc="state.error"/>
                </t>
            </div>

            <t t-set-slot="footer">
                <button t-if="state.step === 'reference'" class="btn btn-primary btn-lg"
                        t-att-disabled="walletShortfall and true"
                        t-on-click="confirm">
                    Add to order
                </button>
                <button class="btn btn-secondary btn-lg" t-on-click="() => this.props.close()">
                    Cancel
                </button>
            </t>
        </Dialog>
    </t>

</templates>
