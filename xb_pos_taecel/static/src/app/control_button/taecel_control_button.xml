<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="xb_pos_taecel.ControlButton">
        <button
            t-if="isAvailable"
            t-att-class="props.buttonClass"
            t-on-click="onClick">
            <i class="fa fa-signal me-2" role="img" aria-label="Airtime" title="Airtime"/>
            <span>Recharges</span>
        </button>
    </t>

    <!-- Insert the button into the expanded ("More") control-buttons panel,
         wearing the same classes the POS gives its own buttons there. -->
    <t t-inherit="point_of_sale.ControlButtons" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('control-buttons-modal')]" position="inside">
            <XbTaecelControlButton buttonClass="buttonClass"/>
        </xpath>
    </t>

</templates>
